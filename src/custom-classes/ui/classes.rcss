#classes { position: absolute; left: 100px; top: 20px; width: 760px; }
.head { font-family: "Sacred Game"; }
.cols { display: flex; flex-direction: row; margin-top: 6px; }
.left { width: 230px; height: 380px; overflow-y: auto; margin-right: 14px; }
.right { flex: 1 1 auto; height: 380px; overflow-y: auto; }
button.crow { display: block; width: 100%; margin: 0 0 3px 0; padding: 3px 8px; text-align: left; height: auto; background-color: #12121c; border: 1px #4a4030; }
button.crow.on { background-color: #4a3f2a; border-color: #ffd780; }
button.crow:hover { border-color: #ffe030; }
.cname { display: block; color: #ffd780; font-size: 14dp; }
.cbody { color: #9a9a9a; font-size: 12dp; }
.ccount { float: right; color: #9a9a9a; font-size: 11dp; }
.wrap { white-space: pre-wrap; font-size: 14dp; }
.skills { display: flex; flex-direction: row; flex-wrap: wrap; }
.skill { width: 33%; font-size: 13dp; }
.art { display: flex; flex-direction: row; align-items: center; padding: 2px 4px; border-bottom: 1px #2a2418; }
.aicon { width: 40px; height: 40px; margin-right: 8px; }
.atext { flex: 1 1 auto; }
.aname { color: #ffd780; font-size: 14dp; }
.ahow { font-size: 12dp; }
.tier { font-size: 12dp; color: #b0a890; text-align: right; width: 110px; }
.tier.good { color: #60c060; }
.tier.warn { color: #e0a030; }
.tier.bad { color: #c04040; }
.foot { margin-top: 8px; }
.small { font-size: 12dp; }
button.game-button.dim { opacity: 0.55; }
scrollbarvertical { width: 14px; }
scrollbarvertical slidertrack { background-color: #0c0c14; }
scrollbarvertical sliderbar { background-color: #8c7440; width: 14px; }
