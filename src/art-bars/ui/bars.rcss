.bar { position: absolute; box-sizing: border-box; height: 52dp; background-color: #00000080; }
.bar .slot { box-sizing: border-box; position: relative; display: inline-block; margin: 4dp 0 0 4dp; padding: 0; border: 1px #6e5e3a; background-color: #2a2418; }
.bar .slot.edit { border-color: #ffd780; }
.bar .slot:hover, .bar .slot:focus { border-color: #ffe030; }
.slot .icon { position: absolute; left: 3dp; top: 3dp; }
.slot .glyph { position: absolute; left: 0px; right: 0px; top: 30%; text-align: center; color: #e8c878; font-size: 18dp; }
.slot .cd { position: absolute; left: 3dp; right: 3dp; top: 3dp; background-color: #000000a0; }
.slot .cdn { position: absolute; left: 0px; right: 0px; top: 38%; text-align: center; color: #ffffff; font-size: 14dp; font-weight: bold; }
.slot .key { position: absolute; left: 4dp; bottom: 2dp; color: #ffffff; font-size: 10dp; }
.bar .side { position: absolute; left: 100%; top: 4dp; margin-left: 4dp; }
.page { display: block; font-size: 11dp; }
#picker { position: absolute; left: 200dp; top: 100dp; width: 520dp; }
.plist { height: 320dp; overflow-y: auto; margin-top: 6dp; }
.pick { display: block; margin: 0 0 3dp 0; padding: 2dp 6dp; text-align: left; height: 44dp; background-color: #12121c; border: 1px #4a4030; }
.pick:hover, .pick:focus { border-color: #ffe030; }
.picon { width: 40dp; height: 40dp; vertical-align: middle; margin-right: 8dp; }
.pglyph { display: inline-block; width: 40dp; text-align: center; color: #e8c878; margin-right: 8dp; }
.ptext { display: inline-block; vertical-align: middle; }
.pname { color: #ffd780; font-size: 14dp; }
.pkind { color: #9a9a9a; font-size: 12dp; }
button.mini { margin: 0; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
