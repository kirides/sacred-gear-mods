<rml>
<head>
    <title>Beastmaster</title>
    <link type="text/rcss" href="beasts.rcss"/>
</head>
<body data-model="model">
<div id="beasts" class="window" data-panel="beasts" data-title="Beastmaster" data-if="open">
    <div data-if="dd != ''" id="beasts-ddshade" class="dd-shade"></div>
    <div class="titlebar"><button id="close-x" class="ibtn titlex" data-close-key="window" data-no-padkey="" title="Close"><span class="icon icon-close"></span></button>{{ title }}</div>
    <div class="body" data-nav-scroll>
        <p data-if="msg != ''" class="amber">{{ msg }}</p>
        <div class="frow modes">
            <span class="accent lab">Take along as</span>
            <button id="mode-ally" class="game-button" data-class-on="mode_ally"><span class="padkey a"></span>Ally ({{ ally_text }})</button>
            <button id="mode-pet" class="game-button" data-class-on="mode_pet"><span class="padkey a"></span>Pet ({{ pet_text }})</button>
        </div>
        <div class="frow">
            <input id="search" type="text" class="field search" data-value="q_text" maxlength="30" placeholder="Filter animals (wolf, bear, spider ...)"/>
            <button class="ibtn kit-kbd" id="kbd-q" title="On-screen keyboard"><span class="padkey a"></span><span class="icon icon-keyboard"></span></button>
            <button class="ibtn" id="clear-q" data-attrif-disabled="q_text == ''" title="Clear the filter"><span class="padkey a"></span><span class="icon icon-close"></span></button>
        </div>
        <div class="muted small">A click on an animal takes it along as {{ mode_text }}. The percentage is the species' base size: change it with the minus and plus buttons.</div>
        <div class="splist" data-nav-scroll>
            <p data-if="none" class="muted">No animal matches.</p>
            <div data-for="s : species" class="srow">
                <button class="game-button sp" data-attr-id="s.id"><span class="padkey a"></span>{{ s.name }}</button>
                <button class="ibtn sz" data-attr-id="s.minus" title="Smaller"><span class="padkey a"></span><span class="icon icon-remove"></span></button>
                <span class="szv">{{ s.scale }}</span>
                <button class="ibtn sz" data-attr-id="s.plus" title="Larger"><span class="padkey a"></span><span class="icon icon-add"></span></button>
            </div>
        </div>
        <div class="sep"></div>
        <div class="head"><span class="accent">With you now</span></div>
        <p data-if="!has_followers" class="muted">Nobody yet.</p>
        <div class="flist" data-nav-scroll>
        <div data-for="f : followers" class="frow">
            <span class="fname">{{ f.name }}</span>
            <span class="muted small frole">{{ f.role }} {{ f.level }}</span>
            <div class="hbar" data-if="f.show_hp"><div class="hfill" data-style-width="f.hp"></div></div><div class="hbar nobar" data-if="!f.show_hp"></div>
            <div class="dd" data-class-open="dd == f.ord_dd"><button class="game-dropdown ord" data-attr-id="f.id_ord" data-attr-title="f.tip_order"><span class="padkey a"></span>{{ f.order }}</button></div>
            <button class="ibtn" data-attr-id="f.id_me" title="Stuck or left behind? This animal joins you where you stand"><span class="padkey a"></span><span class="icon icon-my-location"></span> To me</button>
            <button class="ibtn" data-attr-id="f.id" title="Send this animal away"><span class="padkey a"></span><span class="icon icon-close"></span> Dismiss</button>
        </div>
        </div>
        <div class="frow" data-if="has_followers">
            <span class="accent lab">All animals</span>
            <div class="dd" data-class-open="dd == 'oall'"><button class="game-dropdown ord" id="oall" title="Gives every animal the same orders (a pet can only follow or wait)"><span class="padkey a"></span>{{ all_order }}</button></div>
            <button id="bring-all" class="ibtn" title="Every animal joins you where you stand"><span class="padkey a"></span><span class="icon icon-my-location"></span> All to me</button>
        </div>
        <button id="dismiss-all" class="game-button" data-attrif-disabled="!has_followers"><span class="padkey a"></span>Dismiss all</button>
    </div>
</div>
<!-- The list of the open drop-down: a top-level element of the document, so the scrolling lists never clip it. Placed by the Lua side under its
     button (above it near the screen's bottom); beasts-origin is where the document's (0, 0) lies. -->
<div id="beasts-origin" class="dd-origin"></div>
<div data-if="pop.open" id="beasts-pop" class="dd-list dd-pop" data-nav-scroll data-style-left="pop.left" data-style-top="pop.top" data-style-width="pop.width"><button data-for="o : pop.options" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div>
</body>
</rml>
