<rml>
<head>
    <title>Sprites</title>
    <link type="text/rcss" href="page.rcss"/>
</head>
<body data-model="model">
<div id="page">
    <div data-if="view" id="pop" class="window">
        <div class="titlebar"><span class="tt">{{ v_title }}</span><button id="x" class="mini" title="Close">X</button></div>
        <div class="body">
            <div class="info">{{ v_info }}</div>
            <button id="vpic" class="big" title="Click to close"><div class="bigpic" data-style-decorator="v_deco"></div></button>
            <div class="row">
                <button id="vprev" class="mini"><span class="padkey a"></span>&lt; Previous</button>
                <button id="vnext" class="mini"><span class="padkey a"></span>Next &gt;</button>
                <button id="vcopy" class="mini"><span class="padkey a"></span>Copy class</button>
                <button id="vclose" class="mini"><span class="padkey b"></span>Close</button>
            </div>
        </div>
    </div>
    <div class="row space">
        <span class="accent">{{ title }}</span>
        <span class="good">{{ copied }}</span>
    </div>
    <div class="row">
        <button id="first" class="ibtn" title="First page"><span class="icon icon-first-page"></span></button>
        <button id="prev10" class="mini">-10</button>
        <button id="prev" class="ibtn" title="Previous page"><span class="icon icon-chevron-left"></span></button>
        <button id="next" class="ibtn" title="Next page"><span class="icon icon-chevron-right"></span></button>
        <button id="next10" class="mini">+10</button>
        <button id="last" class="ibtn" title="Last page"><span class="icon icon-last-page"></span></button>
    </div>
    <div class="grid">
        <button data-for="c : cells" class="cell" data-attr-id="c.id" data-attr-title="c.tip">
            <div class="holder" data-style-decorator="c.deco"></div>
            <div class="num">{{ c.n }}</div>
            <div class="dim">{{ c.size }}</div>
        </button>
    </div>
</div>
</body>
</rml>
