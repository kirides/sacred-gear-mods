body { font-size: 13dp; color: #ffd780; }
#mm { position: absolute; left: 700dp; top: 110dp; overflow: hidden; clip: always; background-color: #00000000; }
.strip { position: absolute; overflow: hidden; clip: always; }
.world { position: absolute; left: 0dp; top: 0dp; width: 1dp; height: 1dp; }
.tile { position: absolute; }
.tile img, .mark img { display: block; width: 100%; height: 100%; }
.shade { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.markers { position: absolute; left: 0dp; top: 0dp; overflow: hidden; clip: always; }
.mark { position: absolute; }
.hero { position: absolute; width: 10dp; height: 10dp; background-color: #ffd780; border: 1dp #000000; transform: rotate(45deg); }
.frame { position: absolute; }
.frame.outer { left: 0dp; top: 0dp; border: 2dp #c8aa5a; }
.frame.inner { left: 2dp; top: 2dp; border: 1dp #3a2e1a; }
.ring { position: absolute; display: block; left: 0dp; top: 0dp; }
.ring.in { left: 3dp; top: 3dp; }
.dir { position: absolute; font-family: "Sacred Game"; font-size: 14dp; color: #ffd780; text-align: center; }
.dir.n { left: 0dp; top: 4dp; }
.dir.w { left: 5dp; }
.zoombtns { position: absolute; display: none; flex-direction: row; align-items: center; justify-content: center; width: 68dp; height: 24dp; background-color: #000000a0; }
#mm:hover .zoombtns { display: flex; }
.zoombtns .level { margin: 0 2dp; color: #f0f0f0; font-size: 12dp; }
.zoombtns button.ibtn { margin: 0; padding: 0 4dp; font-size: 16dp; border: 0; }
