#panel { position: absolute; left: 590dp; top: 40dp; width: 410dp; }
.msg { white-space: pre-wrap; }
.small { font-size: 12dp; }
.list { max-height: 360dp; overflow-y: auto; }
.ach { padding: 3dp 6dp; margin: 0 0 4dp 0; background-color: #ffffff16; }
.ach.done { background-color: #4a3814c8; }
.ach .top, .ach .bottom { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.ach .name { color: #e8e8e8; font-weight: bold; }
.ach.done .name, .ach.done .prog { color: #f0c86e; }
.ach .prog { color: #ffffff8c; font-size: 12dp; }
.ach .desc { color: #ffffff8c; font-size: 12dp; }
.ach .bar { width: 80dp; height: 5dp; margin: 0; border: 0; background-color: #ffffff1e; }
.ach .bar .fill { height: 5dp; background-color: #c8a03cdc; }
