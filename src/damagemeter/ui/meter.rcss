#compact { position: absolute; left: 700px; top: 200px; width: 140px; padding: 6px; background-color: #000000b0; border: 1px #806a3c90; font-size: 14dp; }
#full { position: absolute; left: 700px; top: 200px; width: 300px; }
.line { display: flex; flex-direction: row; justify-content: space-between; margin: 1px 0; }
.line .name { flex: 1 1 auto; color: #f0f0f0; }
.line .name.ally { color: #b0b0b0; padding-left: 10px; }
.line .name.mine { color: #ffe6a0; }
.dps, .col { text-align: right; color: #b0b0b0; }
.fighting { color: #90e090; }
.col { width: 56px; color: #f0f0f0; }
.col.wide { width: 66px; }
.col.bad, .bad { color: #ff8080; }
.line.head .col { color: #b0b0b0; font-size: 11dp; }
.solo { position: relative; height: 38px; }
.solo .name { font-size: 14dp; }
.solo .big { position: absolute; right: 0px; top: 0px; font-size: 20dp; color: #f0f0f0; }
.solo .big.fighting { color: #90e090; }
.solo .small { position: absolute; left: 0px; top: 22px; font-size: 11dp; }
.kv { display: flex; flex-direction: row; justify-content: space-between; margin: 1px 0; }
.kv.top { margin-top: 8px; }
.icons { display: flex; flex-direction: row; justify-content: flex-end; margin-top: 4px; }
button.mini { padding: 0 6px; margin: 0 0 0 3px; font-size: 12dp; }
.heading { margin: 8px 0 3px 0; }
.graph { margin-top: 8px; }
.bars { display: flex; flex-direction: row; width: 180px; height: 44px; background-color: #00000060; }
.slot { width: 6px; height: 44px; }
.half { height: 22px; position: relative; }
.half .fill { position: absolute; left: 0px; width: 5px; background-color: #78dc78; }
.half.up .fill { bottom: 0px; }
.half.down .fill { top: 0px; background-color: #f06464; }
