#compact { position: absolute; left: 700dp; top: 200dp; width: 140dp; padding: 6dp; background-color: #000000b0; border: 1px #806a3c90; font-size: 14dp; }
#full { position: absolute; left: 700dp; top: 200dp; width: 300dp; }
.line { display: flex; flex-direction: row; justify-content: space-between; margin: 1px 0; }
.line .name { flex: 1 1 auto; color: #f0f0f0; }
.line .name.ally { color: #b0b0b0; padding-left: 10dp; }
.line .name.mine { color: #ffe6a0; }
.dps, .col { text-align: right; color: #b0b0b0; }
.fighting { color: #90e090; }
.col { width: 56dp; color: #f0f0f0; }
.col.wide { width: 66dp; }
.col.bad, .bad { color: #ff8080; }
.line.head .col { color: #b0b0b0; font-size: 11dp; }
.solo { display: flex; flex-direction: row; justify-content: space-between; align-items: center; min-height: 38dp; }
.solo .who { flex: 1 1 auto; min-width: 0; }
.solo .name { font-size: 14dp; }
.solo .big { flex: none; margin-left: 8dp; font-size: 20dp; color: #f0f0f0; }
.solo .big.fighting { color: #90e090; }
.solo .small { display: block; font-size: 11dp; }
.kv { display: flex; flex-direction: row; justify-content: space-between; margin: 1px 0; }
.kv.top { margin-top: 8dp; }
.icons { display: flex; flex-direction: row; justify-content: flex-end; margin-top: 4dp; }
button.mini { margin: 0 0 0 3dp; }
.heading { margin: 8dp 0 3dp 0; }
.graph { margin-top: 8dp; }
.bars { display: flex; flex-direction: row; width: 180dp; height: 44dp; background-color: #00000060; }
.slot { width: 6dp; height: 44dp; }
.half { display: flex; flex-direction: column; height: 22dp; }
.half.up { justify-content: flex-end; }
.half .fill { flex: none; width: 5dp; background-color: #78dc78; }
.half.down .fill { background-color: #f06464; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
