#screen { position: absolute; left: 112px; top: 50px; width: 800px; height: 668px; }
.titlerow { height: 30px; text-align: center; }
.ttl { font-family: "Sacred Game"; font-size: 20px; color: #ffd780; }
.tool { display: flex; flex-direction: row; align-items: center; height: 40px; }
.tabs { margin-right: 10px; }
button.tab.on { color: #ffe030; }
button.mini { padding: 0 6px; margin: 0 3px 0 0; font-size: 13dp; }
button.cyc { min-width: 140px; }
button.mini.key { min-width: 38px; text-align: center; }
button.mini.wide { min-width: 110px; }
button.game-button { min-width: 0; padding: 0 38px 0 37px; font-size: 16px; margin-right: 6px; }
button.game-button.tab { padding: 0 30px 0 29px; }
.srow { display: flex; flex-direction: row; align-items: center; margin: 4px 0; }
.sfield { flex: 1 1 0px; min-width: 0px; display: flex; flex-direction: row; align-items: center; margin-right: 6px; }
.grow { flex: 1 1 auto; }
.cnt { margin-left: 8px; color: #8c8c8c; font-size: 12dp; }
.main { display: flex; flex-direction: row; margin-top: 4px; }
.left { width: 470px; margin-right: 12px; }
.right { width: 250px; }
#list { height: 356px; overflow-y: auto; }
#list.save { height: 324px; }
.osk { height: 356px; background-color: #101018c0; padding: 6px; }
.osk.save { height: 324px; }
.orow { display: flex; flex-direction: row; margin: 3px 0; }
button.row { display: block; position: relative; width: 100%; height: 50px; overflow: hidden; margin: 0 0 4px 0; padding: 0 6px; text-align: left; background-color: #12121c; border: 1px #4a4030; }
button.row:hover { border-color: #ffe030; }
button.row.sel { background-color: #4a3f2a; border-color: #ffd780; }
.thumb { position: absolute; left: 4px; top: 1px; width: 64px; height: 48px; background-color: #08080c; }
.nopic { display: block; text-align: center; color: #8c8c8c; font-size: 11dp; padding-top: 16px; }
.rtop { position: absolute; left: 72px; right: 6px; top: 3px; height: 20px; line-height: 20px; }
.rtitle { line-height: 18px; font-size: 15dp; font-weight: bold; color: #ffd780; }
.rtitle.dim { color: #8c8c8c; }
.rsub { float: right; font-size: 12dp; color: #f0f0f0; }
.rline { position: absolute; left: 72px; right: 6px; top: 27px; height: 16px; line-height: 16px; font-size: 12dp; color: #8c8c8c; white-space: nowrap; overflow: hidden; }
.pad { margin: 8px; }
.pic { width: 250px; height: 188px; background-color: #08080c; border: 1px #4a4030; }
.dpic { width: 250px; height: 188px; }
.dtitle { font-family: "Sacred Game"; font-size: 16dp; color: #ffd780; margin: 8px 0 2px 0; }
.dfield { display: flex; flex-direction: row; font-size: 12dp; }
.dk { width: 70px; color: #8c8c8c; }
.dv { flex: 1 1 auto; }
.small { font-size: 12dp; }
.namerow { display: flex; flex-direction: row; align-items: center; margin-top: 6px; }
.lab { width: 50px; }
.btns { margin-top: 8px; }
.confirm { display: flex; flex-direction: row; align-items: center; }
.msg { margin: 0 8px; }
scrollbarvertical { width: 14px; }
scrollbarvertical slidertrack { background-color: #0c0c14; }
scrollbarvertical sliderbar { background-color: #8c7440; width: 14px; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
button.game-button, button.mini, button.tab { flex: none; white-space: nowrap; }
