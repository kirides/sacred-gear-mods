#screen { position: absolute; left: 86dp; top: 80dp; width: 800dp; }     /* initial place; main.lua centres the measured panel while open */
.titlerow { height: 30dp; text-align: center; }
.ttl { font-family: "Sacred Game"; font-size: 20dp; color: #ffd780; }
.tool { display: flex; flex-direction: row; align-items: center; height: 34dp; }
.tabs { margin-right: 10dp; }
button.tab.on { color: #ffe030; }
button.mini { margin: 0 3dp 0 0; }
button.cyc { min-width: 140dp; }
button.mini.key { min-width: 38dp; text-align: center; }
button.mini.wide { min-width: 110dp; }
button.game-button { min-width: 0; padding: 0 38dp 0 37dp; font-size: 16dp; margin-right: 6dp; }
button.game-button.tab { padding: 0 30dp 0 29dp; }
.srow { display: flex; flex-direction: row; align-items: center; margin: 4dp 0; }
.sfield { flex: 1 1 0px; min-width: 0px; display: flex; flex-direction: row; align-items: center; margin-right: 6dp; }
.cnt { margin-left: 8dp; color: #8c8c8c; font-size: 12dp; }
.main { display: flex; flex-direction: row; margin-top: 4dp; }
.left { width: 470dp; margin-right: 12dp; }
.right { width: 250dp; }
#list { height: 356dp; overflow-y: auto; }
#list.save { height: 324dp; }
.osk { height: 356dp; background-color: #101018c0; padding: 6dp; }
.osk.save { height: 324dp; }
.orow { display: flex; flex-direction: row; margin: 3dp 0; }
button.row { display: flex; flex-direction: row; align-items: center; width: 420dp; height: 50dp; overflow: hidden; margin: 0 0 4dp 0; padding: 0 4dp; text-align: left; background-color: #12121c; border: 1px #4a4030; }
button.row:hover { border-color: #ffe030; }
button.row.sel { background-color: #4a3f2a; border-color: #ffd780; }
.thumb { flex: none; width: 64dp; height: 48dp; margin-right: 8dp; background-color: #08080c; }
.nopic { display: block; text-align: center; color: #8c8c8c; font-size: 11dp; padding-top: 16dp; }
.port { flex: none; width: 36dp; height: 48dp; margin-left: 6dp; }
.rbody { flex: 1 1 auto; min-width: 0; overflow: hidden; }
.rtop { display: flex; flex-direction: row; justify-content: space-between; align-items: center; height: 22dp; line-height: 20dp; }
.rtitle { flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; line-height: 18dp; font-size: 15dp; font-weight: bold; color: #ffd780; }
.rtitle.dim { color: #8c8c8c; }
.rsub { flex: none; margin-left: 8dp; font-size: 12dp; color: #f0f0f0; }
.rline { height: 18dp; line-height: 16dp; font-size: 12dp; color: #8c8c8c; white-space: nowrap; overflow: hidden; }
.pad { margin: 8dp; }
.pic { width: 250dp; height: 188dp; background-color: #08080c; border: 1px #4a4030; }
.dpic { width: 250dp; height: 188dp; }
.dtitle { font-family: "Sacred Game"; font-size: 16dp; color: #ffd780; margin: 8dp 0 2dp 0; }
.dfield { display: flex; flex-direction: row; font-size: 12dp; }
.dk { width: 70dp; color: #8c8c8c; }
.dv { flex: 1 1 auto; }
.namerow { display: flex; flex-direction: row; align-items: center; margin-top: 6dp; }
.lab { width: 50dp; }
.btns { margin-top: 6dp; }
.confirm { display: flex; flex-direction: row; align-items: center; }
.msg { margin: 0 8dp; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */

/* the drop-down lists of the filters: a button with a caret opens a list of entries under it; the shade behind it takes the click that closes it */
#ddshade { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; z-index: 5; }
