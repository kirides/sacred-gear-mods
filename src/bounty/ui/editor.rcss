#editor { position: absolute; left: 200dp; top: 20dp; width: 640dp; }
.elist { height: 420dp; }
.def { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 3dp 6dp; margin-bottom: 4dp; background-color: #12121c; border: 1px #4a4030; }
.def .dinfo { flex: 1 1 auto; }
.def .title { font-size: 15dp; }
.dbtns { display: flex; flex-direction: row; }
.frow { display: flex; flex-direction: row; align-items: center; margin: 3dp 0; }
.frow.top { align-items: flex-start; }
.lab { width: 140dp; flex: none; color: #9a9a9a; font-size: 13dp; }
.grow { flex: 1 1 auto; }
.val { width: 60dp; text-align: right; margin-left: 6dp; }
input.game-slider { width: 250dp; }
.slider-row { height: 40dp; }
.slider-row .lab { font-family: "Segoe UI"; font-size: 13dp; color: #9a9a9a; }
.chips { display: flex; flex-direction: row; flex-wrap: wrap; }
button.chip { margin: 2dp 4dp 2dp 0; padding: 0 8dp; font-size: 13dp; }
.opts { max-height: 120dp; overflow-y: auto; }
button.opt { display: block; width: 100%; margin: 0; padding: 1px 8dp; text-align: left; font-size: 13dp; background-color: #12121c; border: 1px #4a4030; }
button.mini.wide { min-width: 200dp; }
.check-row { height: 36dp; }
.fscroll { max-height: 520dp; overflow-y: auto; }
.opts { max-height: 96dp; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
button.game-button, button.mini, button.tab { flex: none; white-space: nowrap; }
