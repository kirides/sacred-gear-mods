#editor { position: absolute; left: 200px; top: 20px; width: 640px; }
.elist { height: 420px; }
.def { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 3px 6px; margin-bottom: 4px; background-color: #12121c; border: 1px #4a4030; }
.def .dinfo { flex: 1 1 auto; }
.def .title { font-size: 15dp; }
.dbtns { display: flex; flex-direction: row; }
.frow { display: flex; flex-direction: row; align-items: center; margin: 3px 0; }
.frow.top { align-items: flex-start; }
.lab { width: 140px; flex: none; color: #9a9a9a; font-size: 13dp; }
.grow { flex: 1 1 auto; }
.val { width: 60px; text-align: right; margin-left: 6px; }
input.game-slider { width: 250px; }
.slider-row { height: 40px; }
.slider-row .lab { font-family: "Segoe UI"; font-size: 13dp; color: #9a9a9a; }
.chips { display: flex; flex-direction: row; flex-wrap: wrap; }
button.chip { margin: 2px 4px 2px 0; padding: 0 8px; font-size: 13dp; }
.opts { max-height: 120px; overflow-y: auto; }
button.opt { display: block; width: 100%; margin: 0; padding: 1px 8px; text-align: left; font-size: 13dp; background-color: #12121c; border: 1px #4a4030; }
button.mini.wide { min-width: 200px; }
.check-row { height: 36px; }
.fscroll { max-height: 520px; overflow-y: auto; }
.opts { max-height: 96px; }
