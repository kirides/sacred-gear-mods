#party { position: absolute; left: 192dp; top: 60dp; width: 700dp; }
.lab { width: 110dp; flex: none; }
.small { font-size: 13dp; }
.amber { color: #ffc060; }
.hero { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 4dp; }
.hinfo { display: flex; flex-direction: row; align-items: center; width: 230dp; }
.himg { width: 40dp; height: 40dp; margin-right: 8dp; }
.hname { font-size: 15dp; font-weight: bold; }
.hbar { width: 130dp; height: 6dp; background-color: #000000c0; }
.hfill { height: 6dp; background-color: #60c060; }
.hfill.bad { background-color: #c04040; }
.hbtns { display: flex; flex-direction: row; }
button.mini { margin: 0 3dp 0 0; }
button.mini.wide { min-width: 120dp; }
button.game-button.dis { color: #8a8a8a; opacity: 0.55; }
button.game-button.amber { color: #ffc060; }
button.game-button { min-width: 0; padding: 0 38dp 0 37dp; font-size: 16dp; margin-right: 8dp; }
#party-ddshade { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; z-index: 5; }
.sep { height: 1px; background-color: #6a5a3c80; margin: 6dp 0; }
.frow { display: flex; flex-direction: row; align-items: center; margin: 3dp 0; }
.pname { width: 330dp; }
.tlist { max-height: 330dp; overflow-y: auto; }   /* 11 abilities before it scrolls (at 200 only 6 showed and the rest looked missing) */
.check-row.small { height: 30dp; }
input.game-check.chk { width: 40dp; height: 40dp; }

/* portraits */
/* The game's pictures in decorators without "?dp": the document already scales px of a picture by the canvas (1dp = one
   layout unit), and "?dp" scaled them once more (twice as large at 2560x1440). */
#portraits { position: absolute; width: 92dp; }
/* the grid inside, scaled by the size setting: from the right edge under the game's column, from the left when placed by hand */
.ptgrid { position: absolute; left: 0px; top: 0px; height: 10dp; transform-origin: left top; }
.ptgrid.follow { left: auto; right: 0px; transform-origin: right top; }   /* as wide as the game's column: a wider panel is pushed left off the screen edge */
button.pt { display: block; position: absolute; width: 96dp; height: 132dp; padding: 0; margin: 0; border: 0; background-color: transparent; }
.pt .ring { position: absolute; left: 0px; top: 0px; width: 96dp; height: 108dp; decorator: image(gear:image/42 scale-none left top); }
.pt .redring { position: absolute; left: 0px; width: 96dp; decorator: image(gear:image/41 scale-none left bottom); }
.pt:hover .ring { opacity: 0.85; }
.pt .pimg { position: absolute; left: 8dp; top: 20dp; width: 66dp; height: 72dp; }
.pt.dead .pimg { opacity: 0.45; }
.pt .beadbar { position: absolute; left: 7dp; top: 105dp; width: 73dp; height: 9dp; decorator: image(gear:image/66 scale-none left top); }
.pt .beadfill { position: absolute; left: 1px; top: 1px; height: 7dp; overflow: hidden; decorator: image(gear:image/67 scale-none left top); }
.pt .plevel { position: absolute; left: 12dp; top: 78dp; color: #e8c878; font-size: 12dp; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
