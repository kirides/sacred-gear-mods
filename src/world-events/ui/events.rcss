#bar { position: absolute; left: 402dp; top: 40dp; width: 220dp; }
#boss { position: absolute; left: 302dp; top: 170dp; width: 420dp; }
.pill { position: relative; height: 46dp; margin-bottom: 4dp; border-radius: 23dp; }
.rings { position: absolute; left: 2dp; top: 2dp; width: 42dp; height: 42dp; }
.rings gear-ring { position: absolute; left: 0px; top: 0px; }
.rings gear-ring.outer { width: 42dp; height: 42dp; }
.rings gear-ring.inner { left: 5dp; top: 5dp; width: 32dp; height: 32dp; }
.pct { position: absolute; left: 0px; right: 0px; top: 14dp; text-align: center; font-size: 11dp; font-weight: bold; color: #fff2d0; }
.txt { position: absolute; left: 52dp; right: 10dp; top: 5dp; }
.l1 { height: 17dp; white-space: nowrap; overflow: hidden; }
.ptitle { font-size: 12dp; font-weight: bold; color: #f2d58a; margin-right: 6dp; }
.parea { font-size: 11dp; color: #d2ccbe; }
.l2 { height: 15dp; white-space: nowrap; font-size: 11dp; }
.count { color: #d2ccbe; margin-right: 6dp; }
.timer { color: #9ccbf5; }
.more { font-size: 11dp; color: #d2ccbe; margin-left: 12dp; }
.boss { height: 40dp; margin-bottom: 4dp; }
.bname { height: 17dp; text-align: center; font-size: 14dp; font-weight: bold; color: #f2d58a; }
.bbar { position: relative; height: 21dp; margin-top: 2dp; background-color: #0c0c10c0; border: 1px #4a3a2a; }
.bfill { position: absolute; left: 0px; top: 0px; height: 19dp; }
.btext { position: absolute; left: 0px; right: 0px; top: 2dp; text-align: center; font-size: 11dp; font-weight: bold; color: #f4eedf; }
