<rml>
<head>
    <title>Auction house</title>
    <link type="text/rcss" href="market.rcss"/>
</head>
<body data-model="model">
<div id="open" data-panel="open" data-title="Auction house" data-if="open_shown">
    <button id="ah-toggle" class="open-btn" data-attrif-disabled="!open_enabled" data-attr-title="open_tip"><span class="padkey a"></span>{{ open_label }}</button>
</div>

<div id="market" class="window" data-panel="market" data-title="Auction house" data-if="market_open">
    <div data-if="dd != ''" id="ah-ddshade"></div>
    <div class="titlebar">Auction house</div>
    <div class="body">
        <div class="tabbar"><a data-for="t : tabs" class="link tab" data-attr-id="t.id" data-class-on="t.on">{{ t.name }}</a></div>
        <p data-class-bad="status_bad" class="muted small">{{ status }}</p>

        <div data-if="tab == 'browse'">
            <div class="frow">
                <input type="text" class="field grow" data-value="q_text" maxlength="40" placeholder="Search name or any tooltip line"/>
                <button class="mini" id="kbd-q" title="Type with an on-screen keyboard"><span class="padkey a"></span>Kbd</button>
                <div class="ah-dd" data-class-open="dd == 'cat'"><button class="game-dropdown" id="ah-cat"><span class="padkey a"></span>{{ cat }}</button><div data-if="dd == 'cat'" class="ah-ddlist" data-nav-scroll><button data-for="o : dd_cat" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div></div>
                <div class="ah-dd" data-class-open="dd == 'qual'"><button class="game-dropdown" id="ah-qual"><span class="padkey a"></span>{{ qual }}</button><div data-if="dd == 'qual'" class="ah-ddlist" data-nav-scroll><button data-for="o : dd_qual" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div></div>
            </div>
            <div class="frow">
                <div class="ah-dd" data-class-open="dd == 'level'"><button class="game-dropdown" id="ah-lvl"><span class="padkey a"></span>{{ level }}</button><div data-if="dd == 'level'" class="ah-ddlist" data-nav-scroll><button data-for="o : dd_level" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div></div>
                <div class="ah-dd" data-class-open="dd == 'price'"><button class="game-dropdown" id="ah-price"><span class="padkey a"></span>{{ price }}</button><div data-if="dd == 'price'" class="ah-ddlist" data-nav-scroll><button data-for="o : dd_price" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div></div>
                <button class="mini" id="ah-class" data-class-on="mine_class"><span class="padkey a"></span>{{ class_label }}</button>
                <div class="ah-dd" data-class-open="dd == 'sort'"><button class="game-dropdown" id="ah-sort"><span class="padkey a"></span>{{ sort }}</button><div data-if="dd == 'sort'" class="ah-ddlist" data-nav-scroll><button data-for="o : dd_sort" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div></div>
                <button class="mini" id="ah-desc" title="Sort order"><span class="padkey a"></span>{{ order }}</button>
            </div>
            <div class="frow">
                <button class="mini" id="ah-search"><span class="padkey a"></span>Search</button>
                <span class="muted small grow">{{ count }}</span>
                <button class="mini" id="ah-prev" data-attrif-disabled="!can_prev"><span class="padkey a"></span>&lt;</button><span class="pn">{{ pg }}</span><button class="mini" id="ah-next" data-attrif-disabled="!can_next"><span class="padkey a"></span>&gt;</button>
            </div>
            <p data-if="browse_msg != ''" class="muted">{{ browse_msg }}</p>
            <div class="lst">
                <div data-for="r : rows" class="listing" data-attr-id="r.id">
                    <img class="mi" data-attr-src="r.src"/>
                    <div class="lbody"><div data-style-color="r.color" class="lname">{{ r.name }}</div><div class="muted small">{{ r.detail }}</div></div>
                    <div class="lprice"><div class="gold">{{ r.price }}</div><div class="muted small">{{ r.median }}</div></div>
                    <button class="mini" data-attrif-disabled="r.disabled" data-attr-id="r.buy_id" data-attr-title="r.buy_tip"><span class="padkey a"></span>{{ r.buy }}</button>
                </div>
            </div>
        </div>

        <div data-if="tab == 'sell'">
            <div class="frow"><span class="accent grow">Your backpack and chest: pick an item</span><button class="mini" id="ah-sp" data-attrif-disabled="!sp_prev"><span class="padkey a"></span>&lt;</button><span class="pn">{{ sp_n }}</span><button class="mini" id="ah-sn" data-attrif-disabled="!sp_next"><span class="padkey a"></span>&gt;</button></div>
            <div id="sgrid" class="grid">
                <button data-for="c : cells" class="cell" data-attr-id="c.id" data-class-off="!c.ok" data-class-sel="c.sel" data-style-left="c.x" data-style-top="c.y" data-style-width="c.w" data-style-height="c.h" data-style-border-color="c.color"><img class="icon" data-attr-src="c.src" data-style-width="c.iw" data-style-height="c.ih"/></button>
            </div>
            <p data-if="!has_sel" class="muted">Pick the item to sell above.</p>
            <div data-if="has_sel">
                <div class="listing"><img class="mi" data-attr-src="sel.src"/><div class="lbody"><div data-style-color="sel.color" class="lname">{{ sel.name }}</div><div class="muted small">{{ sel.detail }}</div></div></div>
                <div class="frow"><span class="lab">Price</span><input type="text" class="field price" data-value="price_in" maxlength="10" placeholder="gold"/><button class="mini" id="kbd-price"><span class="padkey a"></span>Kbd</button>
                    <button data-for="s : steps" class="mini" data-attr-id="s.id"><span class="padkey a"></span>{{ s.label }}</button></div>
                <div class="frow"><span class="lab">For</span><div class="ah-dd" data-class-open="dd == 'days'"><button class="game-dropdown" id="ah-days"><span class="padkey a"></span>{{ days }}</button><div data-if="dd == 'days'" class="ah-ddlist" data-nav-scroll><button data-for="o : dd_days" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div></div><span class="muted small">{{ fee }}</span></div>
                <button class="game-button" id="ah-list" data-attrif-disabled="!can_list" title="The item leaves your inventory now; it comes back by the mailbox if it does not sell"><span class="padkey a"></span>Put up for sale</button>
            </div>
        </div>

        <div data-if="tab == 'mine'">
            <p class="accent">{{ mine_title }}</p>
            <div class="lst">
                <div data-for="r : mine_rows" class="listing">
                    <img class="mi" data-attr-src="r.src"/>
                    <div class="lbody"><div data-style-color="r.color" class="lname">{{ r.name }}</div><div class="muted small">{{ r.detail }}</div></div>
                    <button class="mini" data-attrif-disabled="busy" data-attr-id="r.cancel_id" title="Take it off the market; it goes to your mailbox (the fee is not returned)"><span class="padkey a"></span>Cancel</button>
                </div>
                <p data-if="mine_more != ''" class="muted small">{{ mine_more }}</p>
            </div>
        </div>

        <div data-if="tab == 'mail'">
            <p class="gold">{{ wallet }}</p>
            <div class="frow"><input type="text" class="field price" data-value="gold_in" maxlength="10" placeholder="amount"/><button class="mini" id="kbd-gold"><span class="padkey a"></span>Kbd</button>
                <button class="mini" id="ah-dep" data-attrif-disabled="!can_dep" title="Gold you carry into the wallet (buying and fees use it)"><span class="padkey a"></span>Deposit</button>
                <button class="mini" id="ah-wd" data-attrif-disabled="!can_dep" title="Gold from the wallet to your hero"><span class="padkey a"></span>Withdraw</button>
                <button class="mini" id="ah-wall" data-attrif-disabled="!can_all" title="The whole wallet"><span class="padkey a"></span>All</button></div>
            <div class="frow"><span class="accent grow">{{ mail_title }}</span><button class="mini" id="ah-call" data-attrif-disabled="!can_collect"><span class="padkey a"></span>Collect all</button></div>
            <div class="lst">
                <div data-for="e : returns" class="listing ret">
                    <img class="mi" data-attr-src="e.src"/><div class="lbody"><div class="lname">{{ e.name }}</div></div>
                    <button class="mini" data-attr-id="e.take_id"><span class="padkey a"></span>Take</button>
                </div>
                <div data-for="m : mails" class="listing">
                    <img data-if="m.src != ''" class="mi" data-attr-src="m.src"/>
                    <div class="lbody"><div data-style-color="m.color" class="lname">{{ m.name }}</div><div class="muted small">{{ m.reason }}</div></div>
                    <button class="mini" data-attrif-disabled="busy" data-attr-id="m.col_id"><span class="padkey a"></span>Collect</button>
                </div>
                <p data-if="mail_more != ''" class="muted small">{{ mail_more }}</p>
            </div>
            <p class="muted small">Save the game after collecting: an item collected and not saved is lost if the game ends.</p>
        </div>

        <p data-class-good="msg_ok" data-class-bad="!msg_ok" class="foot small">{{ footer }}</p>
    </div>
</div>

<div id="osk" class="window" data-panel="osk" data-title="Type" data-if="osk_open">
    <div class="titlebar">Type</div>
    <div class="body">
        <div class="oskline">{{ osk_text }}|</div>
        <div data-for="row : osk_rows" class="oskrow"><button data-for="k : row" class="mini key" data-attrif-disabled="k.dis" data-attr-id="k.id"><span class="padkey a"></span>{{ k.label }}</button></div>
        <div class="frow"><button class="mini" id="osk-space" data-attrif-disabled="osk_digits"><span class="padkey a"></span>Space</button><button class="mini" id="osk-back"><span class="padkey a"></span>Backspace</button><button class="mini" id="osk-clear"><span class="padkey a"></span>Clear</button><button class="mini" id="osk-done"><span class="padkey a"></span>Done</button></div>
    </div>
</div>
</body>
</rml>
