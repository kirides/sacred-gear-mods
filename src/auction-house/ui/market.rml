<rml>
<head>
    <title>Auction house</title>
    <link type="text/rcss" href="market.rcss"/>
</head>
<body data-model="model">
<div id="open" class="window" data-panel="open" data-title="Auction house" data-if="open_shown">
    <button id="ah-toggle" class="game-button" data-class-dis="!open_enabled" data-attr-title="open_tip">{{ open_label }}</button>
</div>

<div id="market" class="window" data-panel="market" data-title="Auction house" data-if="market_open">
    <div class="titlebar">Auction house</div>
    <div class="body">
        <div class="tabs"><button data-for="t : tabs" class="tab" data-attr-id="t.id" data-class-on="t.on">{{ t.name }}</button></div>
        <p data-class-bad="status_bad" class="muted small">{{ status }}</p>

        <div data-if="tab == 'browse'">
            <div class="frow">
                <input type="text" class="field grow" data-value="q_text" maxlength="40" placeholder="Search name or any tooltip line"/>
                <button class="mini" id="kbd-q" title="Type with an on-screen keyboard">Kbd</button>
                <button class="mini wide" id="ah-cat">{{ cat }}</button>
                <button class="mini wide" id="ah-qual">{{ qual }}</button>
            </div>
            <div class="frow">
                <button class="mini wide" id="ah-lvl">{{ level }}</button>
                <button class="mini wide" id="ah-price">{{ price }}</button>
                <button class="mini" id="ah-class" data-class-on="mine_class">{{ class_label }}</button>
                <button class="mini wide" id="ah-sort">{{ sort }}</button>
                <button class="mini" id="ah-desc" title="Sort order">{{ order }}</button>
            </div>
            <div class="frow">
                <button class="mini" id="ah-search">Search</button>
                <span class="muted small grow">{{ count }}</span>
                <button class="mini" id="ah-prev" data-class-dis="!can_prev">&lt;</button><span class="pn">{{ pg }}</span><button class="mini" id="ah-next" data-class-dis="!can_next">&gt;</button>
            </div>
            <p data-if="browse_msg != ''" class="muted">{{ browse_msg }}</p>
            <div class="lst">
                <div data-for="r : rows" class="listing" data-attr-id="r.id">
                    <img class="mi" data-attr-src="r.src"/>
                    <div class="lbody"><div data-style-color="r.color" class="lname">{{ r.name }}</div><div class="muted small">{{ r.detail }}</div></div>
                    <div class="lprice"><div class="gold">{{ r.price }}</div><div class="muted small">{{ r.median }}</div></div>
                    <button class="mini" data-class-dis="r.disabled" data-attr-id="r.buy_id" data-attr-title="r.buy_tip">{{ r.buy }}</button>
                </div>
            </div>
        </div>

        <div data-if="tab == 'sell'">
            <div class="frow"><span class="accent grow">Your backpack and chest: pick an item</span><button class="mini" id="ah-sp" data-class-dis="!sp_prev">&lt;</button><span class="pn">{{ sp_n }}</span><button class="mini" id="ah-sn" data-class-dis="!sp_next">&gt;</button></div>
            <div id="sgrid" class="grid">
                <button data-for="c : cells" class="cell" data-attr-id="c.id" data-class-off="!c.ok" data-class-sel="c.sel" data-style-left="c.x" data-style-top="c.y" data-style-width="c.w" data-style-height="c.h" data-style-border-color="c.color"><img class="icon" data-attr-src="c.src" data-style-width="c.iw" data-style-height="c.ih"/></button>
            </div>
            <p data-if="!has_sel" class="muted">Pick the item to sell above.</p>
            <div data-if="has_sel">
                <div class="listing"><img class="mi" data-attr-src="sel.src"/><div class="lbody"><div data-style-color="sel.color" class="lname">{{ sel.name }}</div><div class="muted small">{{ sel.detail }}</div></div></div>
                <div class="frow"><span class="lab">Price</span><input type="text" class="field price" data-value="price_in" maxlength="10" placeholder="gold"/><button class="mini" id="kbd-price">Kbd</button>
                    <button data-for="s : steps" class="mini" data-attr-id="s.id">{{ s.label }}</button></div>
                <div class="frow"><span class="lab">For</span><button class="mini wide" id="ah-days">{{ days }}</button><span class="muted small">{{ fee }}</span></div>
                <button class="game-button" id="ah-list" data-class-dis="!can_list" title="The item leaves your inventory now; it comes back by the mailbox if it does not sell">Put up for sale</button>
            </div>
        </div>

        <div data-if="tab == 'mine'">
            <p class="accent">{{ mine_title }}</p>
            <div class="lst">
                <div data-for="r : mine_rows" class="listing">
                    <img class="mi" data-attr-src="r.src"/>
                    <div class="lbody"><div data-style-color="r.color" class="lname">{{ r.name }}</div><div class="muted small">{{ r.detail }}</div></div>
                    <button class="mini" data-class-dis="busy" data-attr-id="r.cancel_id" title="Take it off the market; it goes to your mailbox (the fee is not returned)">Cancel</button>
                </div>
                <p data-if="mine_more != ''" class="muted small">{{ mine_more }}</p>
            </div>
        </div>

        <div data-if="tab == 'mail'">
            <p class="gold">{{ wallet }}</p>
            <div class="frow"><input type="text" class="field price" data-value="gold_in" maxlength="10" placeholder="amount"/><button class="mini" id="kbd-gold">Kbd</button>
                <button class="mini" id="ah-dep" data-class-dis="!can_dep" title="Gold you carry into the wallet (buying and fees use it)">Deposit</button>
                <button class="mini" id="ah-wd" data-class-dis="!can_dep" title="Gold from the wallet to your hero">Withdraw</button>
                <button class="mini" id="ah-wall" data-class-dis="!can_all" title="The whole wallet">All</button></div>
            <div class="frow"><span class="accent grow">{{ mail_title }}</span><button class="mini" id="ah-call" data-class-dis="!can_collect">Collect all</button></div>
            <div class="lst">
                <div data-for="e : returns" class="listing ret">
                    <img class="mi" data-attr-src="e.src"/><div class="lbody"><div class="lname">{{ e.name }}</div></div>
                    <button class="mini" data-attr-id="e.take_id">Take</button>
                </div>
                <div data-for="m : mails" class="listing">
                    <img data-if="m.src != ''" class="mi" data-attr-src="m.src"/>
                    <div class="lbody"><div data-style-color="m.color" class="lname">{{ m.name }}</div><div class="muted small">{{ m.reason }}</div></div>
                    <button class="mini" data-class-dis="busy" data-attr-id="m.col_id">Collect</button>
                </div>
                <p data-if="mail_more != ''" class="muted small">{{ mail_more }}</p>
            </div>
            <p class="muted small">Save the game after collecting: an item collected and not saved is lost if the game ends.</p>
        </div>

        <p data-class-good="msg_ok" data-class-bad="!msg_ok" class="foot small">{{ footer }}</p>
    </div>
</div>

<div id="osk" class="window" data-panel="osk" data-title="Type" data-if="osk_open">
    <div class="titlebar">Type</div>
    <div class="body">
        <div class="oskline">{{ osk_text }}|</div>
        <div data-for="row : osk_rows" class="oskrow"><button data-for="k : row" class="mini key" data-class-dis="k.dis" data-attr-id="k.id">{{ k.label }}</button></div>
        <div class="frow"><button class="mini" id="osk-space" data-class-dis="osk_digits">Space</button><button class="mini" id="osk-back">Backspace</button><button class="mini" id="osk-clear">Clear</button><button class="mini" id="osk-done">Done</button></div>
    </div>
</div>
</body>
</rml>
