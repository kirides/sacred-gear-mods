.cmp { position: absolute; padding: 6dp; font-size: 12dp; color: #e6e6e6; }
#cmpfixed { left: 330dp; top: 120dp; }
.blk { padding: 0 6dp; margin-bottom: 4dp; }
.blk .title { height: 15dp; font-size: 12dp; }
.blk .title.first { }
.blk + .blk .title { border-top: 1px #ffffff40; padding-top: 1px; }
.blk .note { height: 15dp; margin-left: 6dp; color: #a9a9b4; }
.blk .crow { height: 15dp; margin-left: 6dp; white-space: nowrap; }
