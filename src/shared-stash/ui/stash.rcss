#open { position: absolute; left: 646px; top: 572px; width: 200px; }
#open button { white-space: nowrap; }
#stash { position: absolute; left: 646px; top: 6px; width: 372px; }
.head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; height: 24px; }
.pager { display: flex; flex-direction: row; align-items: center; }
.pn { width: 50px; text-align: center; }
.grid { position: relative; width: 352px; height: 192px; margin-bottom: 8px; background-color: #00000060; border: 1px #ffffff30; }
button.cell { box-sizing: border-box; position: absolute; padding: 0; margin: 0; border: 1px #606060; background-color: #203040; }
button.cell:hover { background-color: #506090; border-color: #ffffff; }
button.cell.off { opacity: 0.4; }
button.cell img.icon { position: absolute; left: 1px; top: 1px; }
.status { min-height: 18px; margin-top: 4px; }
.wrap { white-space: pre-wrap; }
.small { font-size: 13dp; }
button.mini { padding: 0 8px; margin: 0 2px; }
button.dis { color: #8c8c8c; border-color: #3c3c3c; opacity: 0.6; }
button.game-button.dis { opacity: 0.55; color: #8a8a8a; }
