/* the opener: a plain small button (no window frame), still a layout panel the player moves while Alt is held */
#open { position: absolute; left: 646dp; top: 572dp; width: 130dp; }
button.open-btn { display: block; width: 100%; margin: 0; }
#stash { position: absolute; left: 646dp; top: 6dp; width: 372dp; }
.head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; height: 24dp; }
.pager { display: flex; flex-direction: row; align-items: center; }
.pn { width: 50dp; text-align: center; }
.grid { position: relative; width: 352dp; height: 192dp; margin-bottom: 8dp; background-color: #00000060; border: 1px #ffffff30; }
button.cell { box-sizing: border-box; position: absolute; padding: 0; margin: 0; border: 1px #606060; background-color: #203040; }
button.cell:hover { background-color: #506090; border-color: #ffffff; }
button.cell.off { opacity: 0.4; }
button.cell img.icon { position: absolute; left: 1px; top: 1px; }
.status { min-height: 18dp; margin-top: 4dp; }
.small { font-size: 13dp; }
button.mini { margin: 0 2dp; }
button.game-button.dis { opacity: 0.55; color: #8a8a8a; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
