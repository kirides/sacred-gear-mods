<rml>
<head>
    <title>Chat</title>
    <link type="text/rcss" href="chat.rcss"/>
</head>
<body data-model="model">
<div id="chat" class="bare" data-panel="chat" data-title="Chat" data-if="open" data-style-background-color="bg" data-style-height="box_h">
    <div class="tabs">
        <div class="tabbar chat"><a data-for="t : tabs" class="link tab" data-attr-id="t.id" data-class-on="t.on">{{ t.label }}</a></div>
        <span class="grow"></span>
        <div data-if="show_player" class="chat-dd" data-class-open="dd_open"><button class="tab" id="player" title="Only the lines of this player"><span class="padkey a"></span>{{ player_label }}<span class="caret">&#9662;</span></button><div data-if="dd_open" class="chat-ddlist" data-nav-scroll><button data-for="o : players" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button></div></div>
        <button class="tab" id="min" data-attr-title="min_tip"><span class="padkey a"></span>{{ min_label }}</button>
    </div>
    <div data-if="!minimized" class="lwrap">
        <div id="lines" data-style-font-size="fs">
            <div data-for="l : lines" data-attr-id="l.id" class="line" data-class-item="l.item"><span data-for="r : l.runs" data-style-color="r.c" data-class-ic="r.ic" data-style-decorator="r.deco" data-style-image-color="r.tint">{{ r.t }}</span></div>
        </div>
        <button data-if="new_label != ''" id="newer" class="tab newer" title="To the newest line"><span class="padkey a"></span>{{ new_label }}</button>
    </div>
</div>
</body>
</rml>
