#chat { position: absolute; left: 8dp; top: 420dp; width: 420dp; padding: 2dp; }
.tabs { display: flex; flex-direction: row; height: 20dp; margin-bottom: 3dp; }
.grow { flex: 1 1 auto; }
button.tab { margin: 0 2dp 0 0; padding: 0 7dp; font-size: 12dp; height: 18dp; line-height: 16dp; }
button.tab.on { border-color: #ffd780; color: #ffd780; }
.lwrap { position: relative; }
#lines { height: 170dp; overflow-y: auto; padding-right: 4dp; }
.line { color: #ffffff; margin: 0 0 1px 0; }
.line span { white-space: pre-wrap; }
.line span.ic { display: inline-block; width: 1.5em; height: 1.4em; vertical-align: middle; }
.line.item:hover { background-color: #ffffff18; }
button.newer { position: absolute; right: 18dp; bottom: 2dp; }
.chat-dd { position: relative; z-index: 10; }
.chat-dd.open { z-index: 100; }
.chat-dd .caret { margin-left: 5dp; color: #ffd780; }
.chat-ddlist { position: absolute; right: 0dp; top: 20dp; min-width: 150dp; max-height: 300dp; overflow-y: auto; z-index: 200; background-color: #0c0c14; border: 1px #ffd780; padding: 2dp; }
.chat-ddlist button.opt { display: block; width: auto; margin: 0 0 1px 0; text-align: left; white-space: nowrap; padding: 4dp 10dp; }
.chat-ddlist button.opt.on { color: #ffe030; border-color: #ffd780; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
button.game-button, button.mini, button.tab { flex: none; white-space: nowrap; }

/* the chat's tab bar is compact and has no line (its row has buttons at the right) */
.tabbar.chat { border-bottom: 0; margin: 0; padding: 0; }
.tabbar.chat a.link.tab { font-size: 13dp; padding: 0 9dp; }
.tabbar.chat a.link.tab + a.link.tab { padding-left: 15dp; }
