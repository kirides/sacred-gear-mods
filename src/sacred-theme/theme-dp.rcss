/* GENERATED by tools/make_theme_dp.py from theme.rcss: do not edit. The same stylesheet for documents laid out in screen pixels (dp = true):
   lengths in dp (a layout unit), hairlines in px, theme-folder pictures sized in layout units (?dp). */
/* Gear theme: the classes RmlUi documents can rely on while this mod runs. Documents only override what is special.
   The look of the legacy mod windows (Better SaveLoad, Damage meter ...): near-black fills with a hint of blue, the game's tooltip frame as the window border,
   a brown title bar, yellow-gold headings, grey secondary text, brown-gold selection. */

body { font-size: 15dp; color: #f0f0f0; }

/* Fonts (families Gear registers: see gear.ui.rml.fonts; each falls back to the modern face when its file is missing). Body text stays modern; the native-looking pieces
   (game-button, titlebar, heading, check-row text, list item names) use the game's own font, and any element can pick one with a class: .font-game (ANTQS__.TTF),
   .font-default (Segoe UI) and .font-start (CAROLING.TTF, the start screen's, hard to read). The classes (written with a repeated class so they win over the rules of the pieces). */

/* A window: .window is the frame (the game's tooltip border and fill); .titlebar its brown header with the title and a close mark; .body the content. */
.window {
    /* The game's own frame (tooltip: bars, fill, overhanging corner ornaments) is drawn by Gear behind every top-level element with
       class "window" or data-frame="tooltip" (gear.ui.native.frame); a CSS decorator cannot overhang. The bars sit 6dp inside the box: keep the padding. */
    padding: 6dp;
}
.window > .titlebar {
    font-family: "Sacred Game";
    padding: 4dp 10dp;
    background-color: #302418;
    color: #f0c860;
}
.window > .body { padding: 10dp 14dp 12dp 14dp; }
.window.plain { padding: 14dp 16dp; }

/* Utilities every screen needs (they used to be repeated in each mod's stylesheet; Gear's plain base style has the same rules): .small a smaller line, .wrap keeps line breaks,
   .grow takes the free room of a flex row, .warn / .gold / .xp colour a text, button.dis a button that cannot be used now (it stays a pad stop). */
.small { font-size: 12dp; }
.wrap { white-space: pre-wrap; }
.grow { flex: 1 1 auto; }
.warn { color: #ffc878; }
.gold { color: #ffd778; }
.xp { color: #9cd0ff; }
button.dis { color: #8c8c8c; border-color: #3c3c3c; opacity: 0.6; }

/* Text: .heading is a section title in the gold of the legacy headings; .label / .value are a grey name and its white value. */
.heading { font-family: "Sacred Game"; color: #f0c860; margin: 8dp 0 4dp 0; }
.label { color: #9a9a9a; }
.value { color: #f0f0f0; }
.muted { color: #8c8c8c; }
.accent { color: #ffd780; }
.good { color: #7fd37f; }
.bad { color: #e06060; }

/* Rows: .row lays its children out side by side; .right pushes them to the right edge; .space puts the first at the left, the last at the right. */
.row { display: flex; flex-direction: row; margin: 6dp 0; }
.row.right { justify-content: flex-end; }
.row.space { justify-content: space-between; }

/* Buttons (pad stops, like every button): dark fill, dim gold edge; hover brightens the edge; .primary has the bright gold edge. */
button {
    margin-right: 8dp;
    padding: 4dp 14dp;
    line-height: 1.5;                  /* tall enough that the descenders of a label are not cut (small buttons set their own padding) */
    color: #f0f0f0;
    background-color: #14141f;
    border: 1px #8c7440;
    cursor: pointer;
    transition: transform 0.12s cubic-out;
}
button:hover, button:focus { background-color: #24243a; border-color: #ffd780; transform: scale(1.03); }
button:active { background-color: #34344e; }
button.primary { border-color: #c8aa5a; color: #ffd780; }
button.danger { border-color: #a84030; }
button:disabled { color: #8c8c8c; border-color: #3c3c3c; transform: none; }

/* Text fields and selects. A text field is the game's pill: a rounded frame with room at the ends, and the caret is the game's blinking underscore at the
   foot of the text (caret-style, a property of Sacred Gear's RmlUi; where it is unknown the usual thin vertical caret stays). The focused field has the gold edge. */
input.field, select.field {
    padding: 2dp 16dp;
    line-height: 26dp;
    color: #f0f0f0;
    background-color: #0c0c14;
    border: 1px #6e5e3a;
    border-radius: 16dp;
}
input.field { caret-style: underscore; caret-color: #ffd780; }
input.field:focus, select.field:focus { border-color: #ffd780; }
/* The selected text of a field (mouse, Shift + arrows, Ctrl + A): the brown-gold of the lists, over light text. */
input.field selection, textarea selection { background-color: #8a6a28cc; color: #fff2c8; }

/* Lists: .list holds .item rows (a thumbnail, a gold .name, grey .sub); .selected is the brown-gold chosen row. Make an item a button to make it a pad stop. */
.list { margin: 4dp 0; }
.list .item { padding: 6dp 10dp; margin-bottom: 4dp; background-color: #12121c; border: 1px #4a4030; }
.list .item:hover { border-color: #c8aa5a; }
/* An item that is a button (a pad stop) is a row like the others, not a shrunk inline box. */
.list button.item { display: block; margin-right: 0; text-align: left; }
.list .item.selected { background-color: #4a3f2a; border-color: #ffd780; }
.item .name { font-family: "Sacred Game"; color: #ffd780; font-weight: bold; }
.item .sub { color: #9a9a9a; }

/* Bars (health, progress): <div class="bar"><div class="fill" style="width: 40%"/></div>. */
.bar { height: 10dp; margin: 4dp 0; background-color: #0c0c14; border: 1px #6e5e3a; }
.bar .fill { height: 10dp; background-color: #a82828; }
.bar.mana .fill { background-color: #2f6fd0; }
.bar.xp .fill { background-color: #7fd37f; }

/* Clickable text (like a hyperlink that opens a dialogue or popup; the entries of Sacred's own menus): cream text that blooms while
   hovered or focused with the pad, as the game's menu entries do. Use on <a> (a pad stop) or any element with data-nav. The bloom is
   RmlUi's glow font effect: the glyphs are blurred into a halo (outline 2dp, blur 6dp) in the text's own shape, baked into the glyph
   textures, so it needs no off-screen render targets. */
.link {
    display: inline-block;
    padding: 4dp 22dp;
    color: #e8d8a8;
    cursor: pointer;
    text-align: center;
}
.link:hover, .link:focus { color: #fff6d0; font-effect: glow(2dp 6dp 0px 0px #ffb840e6); }
.link:active { color: #ffffff; font-effect: glow(3dp 8dp 0px 0px #ffe9a8ff); }     /* the click: the same bloom, brighter and wider */
.link.big { font-size: 1.25em; }

/* Tab headers (not buttons, so nobody takes them for a button that does something in the content): <div class="tabbar"><a class="link tab on">One</a><span class="tab-sep"></span><a class="link tab">Two</a></div>.
   The anchors are the .link text with its bloom on hover and pad focus, separated by thin vertical lines with a little room around them, and one horizontal line runs under the whole bar. The open tab is bright gold with a short bar on the line. */
.tabbar { display: flex; flex-direction: row; align-items: center; padding: 0 0 4dp 0; margin: 0 0 10dp 0; border-bottom: 1px #8c7440c0; }
.tabbar a.link.tab { padding: 3dp 14dp; font-family: "Sacred Game"; font-size: 17dp; }
.tabbar a.link.tab.on { color: #ffcf40; border-bottom: 2dp #ffcf40; margin-bottom: -5px; padding-bottom: 5dp; }   /* the open tab: brighter, with a short gold bar on the bar's line */
.tabbar a.link.tab + a.link.tab { border-left: 1px #8c744099; margin-left: 6dp; padding-left: 20dp; }   /* tabs made with data-for: the separator is the next tab's left edge */
.tabbar .tab-sep { width: 1px; height: 20dp; margin: 0 6dp; background-color: #8c744099; }

/* Controller prompts: <img class="padkey" src="gear:pad/a"/> in front of the text inside a button; shown only while the controller was used last
   (gear sets body.pad), sized with the text. */
.padkey { display: none; width: 1.3em; height: 1.3em; margin-right: 0.5em; vertical-align: middle; }
body.pad .padkey { display: inline-block; }
/* The confirm prompt (a) belongs to the button or link the pad is on (its focus or hover: the pad's cursor is the pointer; written with > and the element, since an ancestor is hovered too): it shows there only, and takes room
   only then (a button's text stays centred; it moves over while the prompt shows). Every other prompt (b, y, lb, rb, back ...) is the shortcut of its own that the control has and shows
   while the controller is in use; on the control the pad is on it becomes the confirm prompt. Gear puts a confirm prompt into every button that has none. */
body.pad .padkey.a { display: none; }
body.pad button:focus > .padkey.a, body.pad button:hover > .padkey.a, body.pad a:focus > .padkey.a, body.pad a:hover > .padkey.a { display: inline-block; }
body.pad button:focus > span.padkey.b, body.pad button:hover > span.padkey.b, body.pad button:focus > span.padkey.x, body.pad button:hover > span.padkey.x,
body.pad button:focus > span.padkey.y, body.pad button:hover > span.padkey.y, body.pad button:focus > span.padkey.lb, body.pad button:hover > span.padkey.lb,
body.pad button:focus > span.padkey.rb, body.pad button:hover > span.padkey.rb, body.pad button:focus > span.padkey.back, body.pad button:hover > span.padkey.back,
body.pad button:focus > span.padkey.start, body.pad button:hover > span.padkey.start { decorator: image(gear:pad/a contain); }

/* The same prompts without an <img>: <span class="padkey a"></span> (a span is sized like the img, the glyph is its decorator). */
span.padkey.a { decorator: image(gear:pad/a contain); }
span.padkey.b { decorator: image(gear:pad/b contain); }
span.padkey.x { decorator: image(gear:pad/x contain); }
span.padkey.y { decorator: image(gear:pad/y contain); }
span.padkey.lb { decorator: image(gear:pad/lb contain); }
span.padkey.rb { decorator: image(gear:pad/rb contain); }
span.padkey.lt { decorator: image(gear:pad/lt contain); }
span.padkey.rt { decorator: image(gear:pad/rt contain); }
span.padkey.back { decorator: image(gear:pad/back contain); }
span.padkey.start { decorator: image(gear:pad/start contain); }
span.padkey.l3 { decorator: image(gear:pad/l3 contain); }
span.padkey.r3 { decorator: image(gear:pad/r3 contain); }
span.padkey.up { decorator: image(gear:pad/up contain); }
span.padkey.down { decorator: image(gear:pad/down contain); }
span.padkey.left { decorator: image(gear:pad/left contain); }
span.padkey.right { decorator: image(gear:pad/right contain); }

/* The thick frame of the character selection and the other big menu screens (class thick-frame, or data-frame="thick" on a top-level element;
   Gear draws it behind the window like the thin one). The border is 22 units at the sides, 25 on top and 28 at the bottom (the rounded corners are inside the box): keep the padding. Dividers: data-dividers="142"
   (offsets from the top where a bar runs across). */
.thick-frame { padding: 29dp 26dp 32dp 26dp; }
/* Where the dark fill starts inside the border (the game sets it per window; Gear reads these classes): bg-fill-settings is the bigger gap (22 / 24.5 / 22 / 24.5, the character selection and the settings screens), bg-fill-dialog the thin one (16 / 20 / 15 / 18, the confirmation popup); without either the default is the settings gap. data-fill-inset="l t r b" overrides. */

/* The compact game button (class mini on a <button>, for pagers, row actions and toolbars): the same orb caps and middle (280 / 281 / 282) scaled to the height of the
   button, so it fits where the big game-button does not. Mods only choose its margin (and min-width with .wide / .key). Every button keeps its label on one line. */
button { flex: none; white-space: nowrap; }
button.mini {
    display: inline-block;
    height: 28dp;
    min-width: 56dp;
    margin: 0 4dp 0 0;
    padding: 0 24dp;
    border: 0;
    background-color: transparent;
    decorator: tiled-horizontal(gear:image/280, gear:image/281, gear:image/282);
    color: #e4e4e4;
    font-family: "Sacred Game";
    font-size: 14dp;
    line-height: 28dp;
    text-align: center;
    cursor: pointer;
    transform: none;
}
button.mini:hover, button.mini:focus { color: #ffe030; background-color: transparent; border: 0; transform: none; }
button.mini:active { color: #fff2a0; }
button.mini.on { color: #ffd54a; }
/* The close button of a window: in its title bar at the right (<button class="ibtn titlex" data-close-key="panel">; Gear fires that declared key of the mod, the pad's B does the same). */
.titlebar .titlex { float: right; margin: -2px 0 0 8dp; padding: 0 6dp; font-size: 15dp; }
/* Icon buttons (class ibtn on a <button> that holds only an icon: pagers, backspace, close ...): no frame, the glow text of .link; the icon takes the text colour. */
button.ibtn {
    display: inline-block;
    flex: none;
    min-width: 0;
    height: auto;
    margin: 0 4dp 0 0;
    padding: 2dp 8dp;
    border: 0;
    background-color: transparent;
    decorator: none;
    color: #e8d8a8;
    font-family: "Sacred Game";
    font-size: 16dp;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transform: none;
}
button.ibtn { align-self: center; }
/* The keyboard button of a text field (gear.kit.field, or any `ibtn kit-kbd`): only while the controller is the input. */
button.ibtn.kit-kbd { display: none; }
body.pad button.ibtn.kit-kbd { display: inline-block; }
.kit-field { display: flex; flex-direction: row; align-items: center; }
button.ibtn:hover, button.ibtn:focus { color: #fff6d0; background-color: transparent; transform: none; font-effect: glow(2dp 6dp 0px 0px #ffb840e6); }
/* Icon / text buttons side by side are separated by a thin vertical bar, as the tabs of a .tabbar are: */
button.ibtn + button.ibtn { border-left: 1px #8c744099; margin-left: 4dp; padding-left: 12dp; }
button.ibtn + button.ibtn:hover, button.ibtn + button.ibtn:focus, button.ibtn + button.ibtn:active { border-color: #8c744099; }
button.ibtn:active { color: #ffffff; font-effect: glow(3dp 8dp 0px 0px #ffe9a8ff); }
button.ibtn:disabled, button.ibtn[disabled] { color: #6a6a6a; font-effect: none; }

/* The on-screen keyboard (gear.kit.osk): the typed text in a dark field, rows of keys. The keys are plain bordered buttons (a thin gold edge on a dark fill, no game orb):
   a keyboard has too many of them for the big game buttons, and the pad cursor reads better on a bright edge. */
.kit-osk > .body { background-color: #0d0c12f5; }
.kit-osk .osk-line { display: flex; flex-direction: row; align-items: center; height: 32dp; margin: 0 0 10dp 0; padding: 0 10dp; background-color: #0c0c14; border: 1px #6e5e3a; white-space: pre; overflow: hidden; }
.kit-osk .osk-text { color: #f0f0f0; font-size: 16dp; }
.kit-osk .osk-caret { color: #ffd780; font-size: 16dp; }
.kit-osk .osk-count { margin-left: auto; padding-left: 10dp; color: #8c8c8c; font-size: 12dp; }
.kit-osk .osk-row { display: flex; flex-direction: row; justify-content: center; margin: 4dp 0; }
button.osk-key { display: inline-block; flex: none; width: 42dp; height: 34dp; margin: 0 3dp; padding: 0; border: 1px #8c7440; background-color: #14141f; color: #e4e4e4; font-family: "Sacred Game"; font-size: 16dp; line-height: 32dp; text-align: center; cursor: pointer; transform: none; }
button.osk-key:hover, button.osk-key:focus { color: #ffe030; border-color: #ffe030; background-color: #262636; transform: none; }
button.osk-key:active { color: #fff2a0; background-color: #34344e; }
button.osk-key.wide { width: 62dp; font-size: 14dp; }
button.osk-key.space { width: 182dp; font-size: 14dp; }
button.osk-key.pad { width: 64dp; height: 44dp; line-height: 42dp; font-size: 20dp; }
button.osk-key.txt { font-size: 14dp; }
button.osk-key.half { width: 100dp; font-size: 14dp; }
button.osk-key.on { color: #ffd54a; border-color: #ffd54a; background-color: #3a3020; }
button.osk-key.done { border-color: #c8aa5a; color: #ffd780; }
button.osk-key .icon { font-size: 16dp; }
/* Tab buttons (class tab on a <button>, where a window keeps its own tab row): the look of the .tabbar links, the open one (.on) bright with a bar under it. */
button.tab { display: inline-block; flex: none; margin: 0 4dp 0 0; padding: 3dp 12dp; border: 0; background-color: transparent; color: #e8d8a8; font-family: "Sacred Game"; font-size: 15dp; white-space: nowrap; cursor: pointer; transform: none; }
button.tab:hover, button.tab:focus { color: #ffe030; background-color: transparent; border: 0; transform: none; }
button.tab.on { color: #ffcf40; border-bottom: 2dp #ffcf40; }
button.mini:disabled, button.mini[disabled], button.mini.dis { color: #8a8a8a; opacity: 0.55; border: 0; }

/* The game's drop-down button (class game-dropdown on a <button>): the arrow orbs of the options screens, the left cap (image 267) and the right cap (270) keep their
   size and the middle (281) is tiled, so it is as wide as its label needs (never put a chevron into the label). The list it opens is a .list of .item buttons below it
   (the mod keeps the open state); wrap both in an element with position: relative if the list floats. */
button.game-dropdown {
    display: inline-block;
    height: 37dp;
    min-width: 130dp;
    margin: 0 8dp 0 0;
    padding: 0 40dp;
    border: 0;
    background-color: transparent;
    decorator: image(gear:image/281 repeat-x) content-box, image(gear:image/267 scale-none left center) border-box, image(gear:image/270 scale-none right center) border-box;
    color: #e4e4e4;
    font-family: "Sacred Game";
    font-size: 16dp;
    line-height: 31dp;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
    transform: none;
}
button.game-dropdown:hover, button.game-dropdown:focus { color: #ffe030; background-color: transparent; border: 0; transform: none; }
button.game-dropdown:disabled, button.game-dropdown[disabled], button.game-dropdown[disabled]:hover, button.game-dropdown[disabled]:focus { color: #8a8a8a; opacity: 0.55; }

/* Drop-down popups (made to flow, absolute only where a popup must float): <div class="dd" data-class-open="..."><button class="game-dropdown">..</button><div class="dd-list">
   <button class="mini opt on">..</button></div></div>. .dd is the anchor (the list opens right below the button, over what follows), .dd-list the floating list, .opt its entries,
   .dd-shade a full-size layer behind an open list that takes the click that closes it. */
.dd { position: relative; display: inline-block; flex: none; z-index: 10; }
.dd.open { z-index: 100; }
.dd-list { position: absolute; left: 0; top: 100%; min-width: 150dp; max-height: 300dp; overflow-y: auto; z-index: 200; background-color: #0c0c14; border: 1px #ffd780; padding: 2dp; }
.dd-list button.opt { display: block; width: auto; min-width: 0; height: auto; margin: 0; padding: 3dp 10dp; text-align: left; white-space: nowrap; color: #e8e8e8; border: 0; background-color: transparent; decorator: none; font-family: "Segoe UI"; font-size: 15dp; line-height: 1.4; transform: none; }
.dd-list button.opt:hover, .dd-list button.opt:focus, .dd-list button.opt.on { background-color: #ffd78030; border: 0; color: #ffe030; }
.dd-shade a full-size layer behind an open list that takes the click that closes it. */
.dd { position: relative; display: inline-block; flex: none; z-index: 10; }
.dd.open { z-index: 100; }
.dd-list { position: absolute; left: 0; top: 100%; min-width: 150dp; max-height: 300dp; overflow-y: auto; z-index: 200; background-color: #0c0c14; border: 1px #ffd780; padding: 2dp; }
.dd-list button.opt { display: block; width: auto; margin: 0 0 1px 0; text-align: left; white-space: nowrap; padding: 4dp 10dp; }
.dd-list button.opt.on { color: #ffe030; border-color: #ffd780; }
.dd-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 5; }
/* A list that floats above everything (windows whose scrolling lists would clip a .dd-list): a top-level element <div class="dd-list dd-pop">, placed by the mod
   (left / top in dp) under its button, and an empty <div class="dd-origin"> as the marker where the document's (0, 0) lies, for the mod to measure from. */
.dd-origin { position: absolute; left: 0px; top: 0px; width: 1px; height: 1px; visibility: hidden; }
.dd-pop { position: absolute; z-index: 300; }

/* The game's own button (class game-button on a <button>): the orb caps (images 280 / 282) keep their size, only the middle (281) is tiled, so a button
   of any width works; the label is centred in the middle part and the pad prompt (.padkey) sits in front of it. Normal grey-white label, hover
   yellow (and with the pad focus; the glow is for the frameless .link only), pressed the other plate (283 to 285), disabled dim. */
button.game-button {
    display: inline-block;
    height: 37dp;
    min-width: 100dp;
    margin: 0 8dp 0 0;
    padding: 0 46dp 0 45dp;
    border: 0;
    background-color: transparent;
    decorator: image(gear:image/281 repeat-x) content-box, image(gear:image/280 scale-none left center) border-box, image(gear:image/282 scale-none right center) border-box;
    color: #e4e4e4;
    font-family: "Sacred Game";
    font-size: 18dp;
    line-height: 31dp;
    text-align: center;
    cursor: pointer;
    transform: none;
}
button.game-button:hover, button.game-button:focus {
    color: #ffe030;
    background-color: transparent;
    border: 0;
    transform: none;
}
button.game-button:active { decorator: image(gear:image/284 repeat-x) content-box, image(gear:image/283 scale-none left center) border-box, image(gear:image/285 scale-none right center) border-box; color: #fff2a0; }
button.game-button:disabled, button.game-button[disabled], button.game-button[disabled]:hover, button.game-button[disabled]:focus { color: #8a8a8a; opacity: 0.55; font-effect: none; }

/* Check boxes and radio buttons of the game (class game-check on <input type="checkbox"> or "radio"): the orb of the options screens,
   plain (image 272) and with the golden check (323), kept at its own size in a box a little larger. Hover and pad focus add a whitish bloom
   (bloom-plain.png?dp / bloom-check.png?dp, listed first, so drawn over the orb (RmlUi draws the first decorator on top): the per-pixel overlay measured from the game's own hover, which brightens the sphere with its gloss and spills 1 to 2 px past the ring); no pressed state. Disabled: dim, no bloom. .check-row: the label text on the left, the orb on the right. */
input.game-check {
    display: inline-block;
    width: 52dp;
    height: 52dp;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: transparent;
    decorator: image(gear:image/272 scale-none center center);
    cursor: pointer;
}
input.game-check:checked { decorator: image(gear:image/323 scale-none center center); }
input.game-check:hover, input.game-check:focus { decorator: image(bloom-plain.png?dp), image(gear:image/272 scale-none center center); }
input.game-check:checked:hover, input.game-check:checked:focus { decorator: image(bloom-check.png?dp), image(gear:image/323 scale-none center center); }
input.game-check:active { decorator: image(bloom-plain.png?dp), image(gear:image/272 scale-none center center); }
input.game-check:checked:active { decorator: image(bloom-check.png?dp), image(gear:image/323 scale-none center center); }
input.game-check[disabled], input.game-check[disabled]:hover, input.game-check[disabled]:focus { opacity: 0.5; decorator: image(gear:image/272 scale-none center center); }
input.game-check[disabled]:checked, input.game-check[disabled]:checked:hover { decorator: image(gear:image/323 scale-none center center); }
.check-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 40dp; }
.check-row .text { font-family: "Sacred Game"; color: #e4e4e4; font-size: 18dp; }

/* Pick a font for any text: the game's own, the modern default, the start screen's. */
.font-game.font-game.font-game, .font-game { font-family: "Sacred Game"; }
.font-start.font-start.font-start, .font-start { font-family: "Sacred Start"; }
.font-default.font-default.font-default, .font-default { font-family: "Segoe UI"; }

/* Sliders of the options screens (class game-slider on <input type="range">): the minus button with the start of the groove (image 263) and the plus
   button with its end (265) are the caps and keep their size, the groove (264) repeats in between, the knob is the star orb (262). RmlUi's slider already
   does what the game does: a press in the track jumps to that value and a drag goes on, the minus and plus buttons step (and repeat while held); Gear
   hands it the real mouse and the pad's D-pad. No glow on the track or the knob. Any width from about 90dp works. */
input.game-slider { display: inline-block; width: 300dp; height: 37dp; margin: 0; padding: 0; border: 0; background-color: transparent; cursor: pointer; }
input.game-slider slidertrack { height: 37dp; decorator: image(gear:image/264 repeat-x); }
input.game-slider sliderbar { width: 30dp; height: 37dp; decorator: image(gear:image/262 scale-none center center); }
input.game-slider sliderarrowdec { width: 36dp; height: 37dp; decorator: image(gear:image/263 scale-none left center); }   /* 36, not the picture's 37: the groove then starts one unit under the orb, which hides the dark first column of its tile (the thin black line right of the minus orb) */
input.game-slider sliderarrowinc { width: 40dp; height: 37dp; decorator: image(gear:image/265 scale-none right center); }
input.game-slider[disabled] { opacity: 0.5; }
.slider-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 44dp; }
.slider-row .text { font-family: "Sacred Game"; color: #e4e4e4; font-size: 18dp; }
/* A data-driven ring (or ring of dots): <gear-ring value="0.4" thickness="3" on="#e0c040" off="#40404080" start="0" dots="0" segments="96"/>, lit clockwise
   from the top for the fraction value of the circle; data-attr-value="expression" redraws it. Its size is its CSS box. */
gear-ring { display: inline-block; width: 40dp; height: 40dp; }

/* Vertical scroll bars of every scrolling box (overflow: auto) in the look of the game's lists: the round arrow buttons (images 298 up, 299 down), the groove
   between them (288) and the star orb as the knob (286). The arrow images (298 / 299) point left and right: turned a quarter, they point up and down. */
scrollbarvertical { width: 30dp; }
scrollbarvertical slidertrack { width: 30dp; decorator: image(gear:image/288 repeat-y center top); background-color: transparent; }
scrollbarvertical sliderbar { width: 30dp; height: 30dp; decorator: image(gear:image/286 scale-none center center); background-color: transparent; }
scrollbarvertical sliderarrowdec { width: 30dp; height: 30dp; decorator: image(gear:image/298?rot=90 scale-none center center); margin-left: -3px; }   /* turned by the picture itself (?rot): a CSS rotation draws these in the wrong place in some boxes; the orb sits 3dp right of the groove axis */
scrollbarvertical sliderarrowinc { width: 30dp; height: 30dp; decorator: image(gear:image/299?rot=90 scale-none center center); margin-left: -3px; }   /* turned by the picture itself (?rot): a CSS rotation draws these in the wrong place in some boxes; the orb sits 3dp right of the groove axis */

/* Arrows to step through values or pages (class arrow on an <a>, next for the right one): the game's white arrows (images 236 and 237, 32x18) in a box a little
   larger, so hover and pad focus can put the warm bloom (arrow-glow-left.png?dp / arrow-glow-right.png?dp, the arrow blurred and tinted like the .link bloom) over
   them. <a class="arrow prev"></a> <a class="arrow next"></a>; class off dims one that cannot go further. */
a.arrow { display: inline-block; width: 52dp; height: 38dp; margin: 0 -4px; vertical-align: middle; cursor: pointer; decorator: image(gear:image/236 scale-none center center); }
a.arrow.next { decorator: image(gear:image/237 scale-none center center); }
a.arrow:hover, a.arrow:focus, a.arrow:active { decorator: image(arrow-glow-left.png?dp scale-none center center), image(gear:image/236 scale-none center center); }
a.arrow.next:hover, a.arrow.next:focus, a.arrow.next:active { decorator: image(arrow-glow-right.png?dp scale-none center center), image(gear:image/237 scale-none center center); }
a.arrow.off, a.arrow.off:hover, a.arrow.off:focus { opacity: 0.35; decorator: image(gear:image/236 scale-none center center); cursor: default; }
a.arrow.next.off, a.arrow.next.off:hover, a.arrow.next.off:focus { decorator: image(gear:image/237 scale-none center center); }

/* The shared templates of this mod (templates/*.rml, exported as @sacred-theme/templates/...): .sacred-screen is the window of the `sacred-screen` body template,
   .sacred-group the framed section of `sacred-group`. Plain flowing boxes: a mod sets its own width, nothing here is positioned. */
.window.sacred-screen { min-width: 300dp; }
.sacred-group { margin: 6dp 0; padding: 6dp 10dp 8dp 10dp; background-color: #12121c; border: 1px #4a4030; }
.sacred-group > .sacred-group-body > .heading:first-child { margin-top: 0; }
