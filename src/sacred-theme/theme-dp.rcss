.sprite-6 { width: 100dp; height: 18dp; decorator: image(gear:image/6?dp scale-none left top); }
.sprite-7 { width: 100dp; height: 17dp; decorator: image(gear:image/7?dp scale-none left top); }
.sprite-8 { width: 105dp; height: 20dp; decorator: image(gear:image/8?dp scale-none left top); }
.sprite-9 { width: 100dp; height: 19dp; decorator: image(gear:image/9?dp scale-none left top); }
.sprite-10 { width: 100dp; height: 19dp; decorator: image(gear:image/10?dp scale-none left top); }
.sprite-11 { width: 231dp; height: 87dp; decorator: image(gear:image/11?dp scale-none left top); }
.sprite-12 { width: 64dp; height: 21dp; decorator: image(gear:image/12?dp scale-none left top); }
.sprite-13 { width: 64dp; height: 18dp; decorator: image(gear:image/13?dp scale-none left top); }
