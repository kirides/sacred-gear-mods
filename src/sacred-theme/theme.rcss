.sprite-40 { width: 18px; height: 18px; decorator: image(gear:image/40 scale-none left top); }
.sprite-41 { width: 96px; height: 108px; decorator: image(gear:image/41 scale-none left top); }
.sprite-42 { width: 96px; height: 108px; decorator: image(gear:image/42 scale-none left top); }
.sprite-43 { width: 32px; height: 1px; decorator: image(gear:image/43 scale-none left top); }
.sprite-44 { width: 1px; height: 32px; decorator: image(gear:image/44 scale-none left top); }
.sprite-45 { width: 32px; height: 32px; decorator: image(gear:image/45 scale-none left top); }
.sprite-46 { width: 33px; height: 32px; decorator: image(gear:image/46 scale-none left top); }
.sprite-47 { width: 32px; height: 32px; decorator: image(gear:image/47 scale-none left top); }
.sprite-48 { width: 32px; height: 32px; decorator: image(gear:image/48 scale-none left top); }
.sprite-49 { width: 33px; height: 32px; decorator: image(gear:image/49 scale-none left top); }
.sprite-50 { width: 64px; height: 19px; decorator: image(gear:image/50 scale-none left top); }
.sprite-51 { width: 68px; height: 23px; decorator: image(gear:image/51 scale-none left top); }
.sprite-52 { width: 7px; height: 37px; decorator: image(gear:image/52 scale-none left top); }
.sprite-53 { width: 10px; height: 37px; decorator: image(gear:image/53 scale-none left top); }
.sprite-54 { width: 38px; height: 20px; decorator: image(gear:image/54 scale-none left top); }
.sprite-55 { width: 38px; height: 18px; decorator: image(gear:image/55 scale-none left top); }
.sprite-56 { width: 38px; height: 37px; decorator: image(gear:image/56 scale-none left top); }
.sprite-57 { width: 38px; height: 37px; decorator: image(gear:image/57 scale-none left top); }
