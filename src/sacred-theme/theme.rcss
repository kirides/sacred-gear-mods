/* Gear theme: the classes RmlUi documents can rely on while this mod runs. Documents only override what is special.
   The look of the legacy mod windows (Better SaveLoad, Damage meter ...): near-black fills with a hint of blue, the game's tooltip frame as the window border,
   a brown title bar, yellow-gold headings, grey secondary text, brown-gold selection. */

body { font-size: 15dp; color: #f0f0f0; }

/* Fonts (families Gear registers: see gear.ui.rml.fonts; each falls back to the modern face when its file is missing). Body text stays modern; the native-looking pieces
   (game-button, titlebar, heading, check-row text, list item names) use the game's own font, and any element can pick one with a class: .font-game (ANTQS__.TTF),
   .font-default (Segoe UI) and .font-start (CAROLING.TTF, the start screen's, hard to read). The classes (written with a repeated class so they win over the rules of the pieces). */

/* A window: .window is the frame (the game's tooltip border and fill); .titlebar its brown header with the title and a close mark; .body the content. */
.window {
    /* The game's own frame (tooltip: bars, fill, overhanging corner ornaments) is drawn by Gear behind every top-level element with
       class "window" or data-frame="tooltip" (gear.ui.native.frame); a CSS decorator cannot overhang. The bars sit 6px inside the box: keep the padding. */
    padding: 6px;
}
.window > .titlebar {
    font-family: "Sacred Game";
    padding: 4px 10px;
    background-color: #302418;
    color: #f0c860;
}
.window > .body { padding: 10px 14px 12px 14px; }
.window.plain { padding: 14px 16px; }

/* Text: .heading is a section title in the gold of the legacy headings; .label / .value are a grey name and its white value. */
.heading { font-family: "Sacred Game"; color: #f0c860; margin: 8px 0 4px 0; }
.label { color: #9a9a9a; }
.value { color: #f0f0f0; }
.muted { color: #8c8c8c; }
.accent { color: #ffd780; }
.good { color: #7fd37f; }
.bad { color: #e06060; }

/* Rows: .row lays its children out side by side; .right pushes them to the right edge; .space puts the first at the left, the last at the right. */
.row { display: flex; flex-direction: row; margin: 6px 0; }
.row.right { justify-content: flex-end; }
.row.space { justify-content: space-between; }

/* Buttons (pad stops, like every button): dark fill, dim gold edge; hover brightens the edge; .primary has the bright gold edge. */
button {
    margin-right: 8px;
    padding: 4px 14px;
    line-height: 1.5;                  /* tall enough that the descenders of a label are not cut (small buttons set their own padding) */
    color: #f0f0f0;
    background-color: #14141f;
    border: 1px #8c7440;
    cursor: pointer;
    transition: transform 0.12s cubic-out;
}
button:hover, button:focus { background-color: #24243a; border-color: #ffd780; transform: scale(1.03); }
button:active { background-color: #34344e; }
button.primary { border-color: #c8aa5a; color: #ffd780; }
button.danger { border-color: #a84030; }
button:disabled { color: #8c8c8c; border-color: #3c3c3c; transform: none; }

/* Text fields and selects. A text field is the game's pill: a rounded frame with room at the ends, and the caret is the game's blinking underscore at the
   foot of the text (caret-style, a property of Sacred Gear's RmlUi; where it is unknown the usual thin vertical caret stays). The focused field has the gold edge. */
input.field, select.field {
    padding: 2px 16px;
    line-height: 26px;
    color: #f0f0f0;
    background-color: #0c0c14;
    border: 1px #6e5e3a;
    border-radius: 16px;
}
input.field { caret-style: underscore; caret-color: #ffd780; }
input.field:focus, select.field:focus { border-color: #ffd780; }

/* Lists: .list holds .item rows (a thumbnail, a gold .name, grey .sub); .selected is the brown-gold chosen row. Make an item a button to make it a pad stop. */
.list { margin: 4px 0; }
.list .item { padding: 6px 10px; margin-bottom: 4px; background-color: #12121c; border: 1px #4a4030; }
.list .item:hover { border-color: #c8aa5a; }
/* An item that is a button (a pad stop) is a row like the others, not a shrunk inline box. */
.list button.item { display: block; margin-right: 0; text-align: left; }
.list .item.selected { background-color: #4a3f2a; border-color: #ffd780; }
.item .name { font-family: "Sacred Game"; color: #ffd780; font-weight: bold; }
.item .sub { color: #9a9a9a; }

/* Bars (health, progress): <div class="bar"><div class="fill" style="width: 40%"/></div>. */
.bar { height: 10px; margin: 4px 0; background-color: #0c0c14; border: 1px #6e5e3a; }
.bar .fill { height: 10px; background-color: #a82828; }
.bar.mana .fill { background-color: #2f6fd0; }
.bar.xp .fill { background-color: #7fd37f; }

/* Clickable text (like a hyperlink that opens a dialogue or popup; the entries of Sacred's own menus): cream text that blooms while
   hovered or focused with the pad, as the game's menu entries do. Use on <a> (a pad stop) or any element with data-nav. The bloom is
   RmlUi's glow font effect: the glyphs are blurred into a halo (outline 2px, blur 6px) in the text's own shape, baked into the glyph
   textures, so it needs no off-screen render targets. */
.link {
    display: inline-block;
    padding: 4px 22px;
    color: #e8d8a8;
    cursor: pointer;
    text-align: center;
}
.link:hover, .link:focus { color: #fff6d0; font-effect: glow(2px 6px 0px 0px #ffb840e6); }
.link:active { color: #ffffff; font-effect: glow(3px 8px 0px 0px #ffe9a8ff); }     /* the click: the same bloom, brighter and wider */
.link.big { font-size: 1.25em; }

/* Tab headers (not buttons, so nobody takes them for a button that does something in the content): <div class="tabbar"><a class="link tab on">One</a><span class="tab-sep"></span><a class="link tab">Two</a></div>.
   The anchors are the .link text with its bloom on hover and pad focus, separated by thin vertical lines with a little room around them, and one horizontal line runs under the whole bar. The open tab is bright gold with a short bar on the line. */
.tabbar { display: flex; flex-direction: row; align-items: center; padding: 0 0 4px 0; margin: 0 0 10px 0; border-bottom: 1px #8c7440c0; }
.tabbar a.link.tab { padding: 3px 14px; font-family: "Sacred Game"; font-size: 17px; }
.tabbar a.link.tab.on { color: #ffcf40; border-bottom: 2px #ffcf40; margin-bottom: -5px; padding-bottom: 5px; }   /* the open tab: brighter, with a short gold bar on the bar's line */
.tabbar a.link.tab + a.link.tab { border-left: 1px #8c744099; margin-left: 6px; padding-left: 20px; }   /* tabs made with data-for: the separator is the next tab's left edge */
.tabbar .tab-sep { width: 1px; height: 20px; margin: 0 6px; background-color: #8c744099; }

/* Controller prompts: <img class="padkey" src="gear:pad/a"/> in front of the text inside a button; shown only while the controller was used last
   (gear sets body.pad), sized with the text. */
.padkey { display: none; width: 1.3em; height: 1.3em; margin-right: 0.5em; vertical-align: middle; }
body.pad .padkey { display: inline-block; }
/* The confirm prompt (a) belongs to the button or link the pad is on (its focus or hover: the pad's cursor is the pointer; written with > and the element, since an ancestor is hovered too): it shows there only, and takes room
   only then (a button's text stays centred; it moves over while the prompt shows). Every other prompt (b, y, lb, rb, back ...) is the shortcut of its own that the control has and shows
   while the controller is in use; on the control the pad is on it becomes the confirm prompt. Gear puts a confirm prompt into every button that has none. */
body.pad .padkey.a { display: none; }
body.pad button:focus > .padkey.a, body.pad button:hover > .padkey.a, body.pad a:focus > .padkey.a, body.pad a:hover > .padkey.a { display: inline-block; }
body.pad button:focus > span.padkey.b, body.pad button:hover > span.padkey.b, body.pad button:focus > span.padkey.x, body.pad button:hover > span.padkey.x,
body.pad button:focus > span.padkey.y, body.pad button:hover > span.padkey.y, body.pad button:focus > span.padkey.lb, body.pad button:hover > span.padkey.lb,
body.pad button:focus > span.padkey.rb, body.pad button:hover > span.padkey.rb, body.pad button:focus > span.padkey.back, body.pad button:hover > span.padkey.back,
body.pad button:focus > span.padkey.start, body.pad button:hover > span.padkey.start { decorator: image(gear:pad/a contain); }

/* The same prompts without an <img>: <span class="padkey a"></span> (a span is sized like the img, the glyph is its decorator). */
span.padkey.a { decorator: image(gear:pad/a contain); }
span.padkey.b { decorator: image(gear:pad/b contain); }
span.padkey.x { decorator: image(gear:pad/x contain); }
span.padkey.y { decorator: image(gear:pad/y contain); }
span.padkey.lb { decorator: image(gear:pad/lb contain); }
span.padkey.rb { decorator: image(gear:pad/rb contain); }
span.padkey.lt { decorator: image(gear:pad/lt contain); }
span.padkey.rt { decorator: image(gear:pad/rt contain); }
span.padkey.back { decorator: image(gear:pad/back contain); }
span.padkey.start { decorator: image(gear:pad/start contain); }
span.padkey.l3 { decorator: image(gear:pad/l3 contain); }
span.padkey.r3 { decorator: image(gear:pad/r3 contain); }
span.padkey.up { decorator: image(gear:pad/up contain); }
span.padkey.down { decorator: image(gear:pad/down contain); }
span.padkey.left { decorator: image(gear:pad/left contain); }
span.padkey.right { decorator: image(gear:pad/right contain); }

/* The thick frame of the character selection and the other big menu screens (class thick-frame, or data-frame="thick" on a top-level element;
   Gear draws it behind the window like the thin one). The border is 22 units at the sides, 25 on top and 28 at the bottom (the rounded corners are inside the box): keep the padding. Dividers: data-dividers="142"
   (offsets from the top where a bar runs across). */
.thick-frame { padding: 29px 26px 32px 26px; }
/* Where the dark fill starts inside the border (the game sets it per window; Gear reads these classes): bg-fill-settings is the bigger gap (22 / 24.5 / 22 / 24.5, the character selection and the settings screens), bg-fill-dialog the thin one (16 / 20 / 15 / 18, the confirmation popup); without either the default is the settings gap. data-fill-inset="l t r b" overrides. */

/* The game's own button (class game-button on a <button>): the orb caps (images 280 / 282) keep their size, only the middle (281) is tiled, so a button
   of any width works; the label is centred in the middle part and the pad prompt (.padkey) sits in front of it. Normal grey-white label, hover
   yellow (and with the pad focus; the glow is for the frameless .link only), pressed the other plate (283 to 285), disabled dim. */
button.game-button {
    display: inline-block;
    height: 37px;
    min-width: 100px;
    margin: 0 8px 0 0;
    padding: 0 46px 0 45px;
    border: 0;
    background-color: transparent;
    decorator: image(gear:image/281 repeat-x) content-box, image(gear:image/280 scale-none left center) border-box, image(gear:image/282 scale-none right center) border-box;
    color: #e4e4e4;
    font-family: "Sacred Game";
    font-size: 18px;
    line-height: 31px;
    text-align: center;
    cursor: pointer;
    transform: none;
}
button.game-button:hover, button.game-button:focus {
    color: #ffe030;
    background-color: transparent;
    border: 0;
    transform: none;
}
button.game-button:active { decorator: image(gear:image/284 repeat-x) content-box, image(gear:image/283 scale-none left center) border-box, image(gear:image/285 scale-none right center) border-box; color: #fff2a0; }
button.game-button:disabled, button.game-button[disabled], button.game-button[disabled]:hover, button.game-button[disabled]:focus { color: #8a8a8a; opacity: 0.55; font-effect: none; }

/* Check boxes and radio buttons of the game (class game-check on <input type="checkbox"> or "radio"): the orb of the options screens,
   plain (image 272) and with the golden check (323), kept at its own size in a box a little larger. Hover and pad focus add a whitish bloom
   (bloom-plain.png / bloom-check.png, listed first, so drawn over the orb (RmlUi draws the first decorator on top): the per-pixel overlay measured from the game's own hover, which brightens the sphere with its gloss and spills 1 to 2 px past the ring); no pressed state. Disabled: dim, no bloom. .check-row: the label text on the left, the orb on the right. */
input.game-check {
    display: inline-block;
    width: 52px;
    height: 52px;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: transparent;
    decorator: image(gear:image/272 scale-none center center);
    cursor: pointer;
}
input.game-check:checked { decorator: image(gear:image/323 scale-none center center); }
input.game-check:hover, input.game-check:focus { decorator: image(bloom-plain.png), image(gear:image/272 scale-none center center); }
input.game-check:checked:hover, input.game-check:checked:focus { decorator: image(bloom-check.png), image(gear:image/323 scale-none center center); }
input.game-check:active { decorator: image(bloom-plain.png), image(gear:image/272 scale-none center center); }
input.game-check:checked:active { decorator: image(bloom-check.png), image(gear:image/323 scale-none center center); }
input.game-check[disabled], input.game-check[disabled]:hover, input.game-check[disabled]:focus { opacity: 0.5; decorator: image(gear:image/272 scale-none center center); }
input.game-check[disabled]:checked, input.game-check[disabled]:checked:hover { decorator: image(gear:image/323 scale-none center center); }
.check-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 40px; }
.check-row .text { font-family: "Sacred Game"; color: #e4e4e4; font-size: 18px; }

/* Pick a font for any text: the game's own, the modern default, the start screen's. */
.font-game.font-game.font-game, .font-game { font-family: "Sacred Game"; }
.font-start.font-start.font-start, .font-start { font-family: "Sacred Start"; }
.font-default.font-default.font-default, .font-default { font-family: "Segoe UI"; }

/* Sliders of the options screens (class game-slider on <input type="range">): the minus button with the start of the groove (image 263) and the plus
   button with its end (265) are the caps and keep their size, the groove (264) repeats in between, the knob is the star orb (262). RmlUi's slider already
   does what the game does: a press in the track jumps to that value and a drag goes on, the minus and plus buttons step (and repeat while held); Gear
   hands it the real mouse and the pad's D-pad. No glow on the track or the knob. Any width from about 90px works. */
input.game-slider { display: inline-block; width: 300px; height: 37px; margin: 0; padding: 0; border: 0; background-color: transparent; cursor: pointer; }
input.game-slider slidertrack { height: 37px; decorator: image(gear:image/264 repeat-x); }
input.game-slider sliderbar { width: 30px; height: 37px; decorator: image(gear:image/262 scale-none center center); }
input.game-slider sliderarrowdec { width: 37px; height: 37px; decorator: image(gear:image/263 scale-none left center); }
input.game-slider sliderarrowinc { width: 40px; height: 37px; decorator: image(gear:image/265 scale-none right center); }
input.game-slider[disabled] { opacity: 0.5; }
.slider-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 44px; }
.slider-row .text { font-family: "Sacred Game"; color: #e4e4e4; font-size: 18px; }
/* A data-driven ring (or ring of dots): <gear-ring value="0.4" thickness="3" on="#e0c040" off="#40404080" start="0" dots="0" segments="96"/>, lit clockwise
   from the top for the fraction value of the circle; data-attr-value="expression" redraws it. Its size is its CSS box. */
gear-ring { display: inline-block; width: 40px; height: 40px; }

/* Vertical scroll bars of every scrolling box (overflow: auto) in the look of the game's lists: the round arrow buttons (images 298 up, 299 down), the groove
   between them (288) and the star orb as the knob (286). The arrow images (298 / 299) point left and right: turned a quarter, they point up and down. */
scrollbarvertical { width: 30px; }
scrollbarvertical slidertrack { width: 30px; decorator: image(gear:image/288 repeat-y center top); background-color: transparent; }
scrollbarvertical sliderbar { width: 30px; height: 30px; decorator: image(gear:image/286 scale-none center center); background-color: transparent; }
scrollbarvertical sliderarrowdec { width: 30px; height: 30px; decorator: image(gear:image/298 scale-none center center); transform: rotate(90deg); }
scrollbarvertical sliderarrowinc { width: 30px; height: 30px; decorator: image(gear:image/299 scale-none center center); transform: rotate(90deg); }

/* Arrows to step through values or pages (class arrow on an <a>, next for the right one): the game's white arrows (images 236 and 237, 32x18) in a box a little
   larger, so hover and pad focus can put the warm bloom (arrow-glow-left.png / arrow-glow-right.png, the arrow blurred and tinted like the .link bloom) over
   them. <a class="arrow prev"></a> <a class="arrow next"></a>; class off dims one that cannot go further. */
a.arrow { display: inline-block; width: 52px; height: 38px; margin: 0 -4px; vertical-align: middle; cursor: pointer; decorator: image(gear:image/236 scale-none center center); }
a.arrow.next { decorator: image(gear:image/237 scale-none center center); }
a.arrow:hover, a.arrow:focus, a.arrow:active { decorator: image(arrow-glow-left.png scale-none center center), image(gear:image/236 scale-none center center); }
a.arrow.next:hover, a.arrow.next:focus, a.arrow.next:active { decorator: image(arrow-glow-right.png scale-none center center), image(gear:image/237 scale-none center center); }
a.arrow.off, a.arrow.off:hover, a.arrow.off:focus { opacity: 0.35; decorator: image(gear:image/236 scale-none center center); cursor: default; }
a.arrow.next.off, a.arrow.next.off:hover, a.arrow.next.off:focus { decorator: image(gear:image/237 scale-none center center); }

/* SPRITES BEGIN (generated by tools/make_sprites_rcss.py: do not edit) */
/* .sprite-N: the game UI image N at its natural size (the sprite-browser mod lists them with their numbers). */
.sprite { display: inline-block; }
.sprite-1 { width: 64px; height: 19px; decorator: image(gear:image/1 scale-none left top); }
.sprite-2 { width: 64px; height: 20px; decorator: image(gear:image/2 scale-none left top); }
.sprite-3 { width: 64px; height: 18px; decorator: image(gear:image/3 scale-none left top); }
.sprite-4 { width: 64px; height: 22px; decorator: image(gear:image/4 scale-none left top); }
.sprite-5 { width: 103px; height: 20px; decorator: image(gear:image/5 scale-none left top); }
.sprite-6 { width: 100px; height: 18px; decorator: image(gear:image/6 scale-none left top); }
.sprite-7 { width: 100px; height: 17px; decorator: image(gear:image/7 scale-none left top); }
.sprite-8 { width: 105px; height: 20px; decorator: image(gear:image/8 scale-none left top); }
.sprite-9 { width: 100px; height: 19px; decorator: image(gear:image/9 scale-none left top); }
.sprite-10 { width: 100px; height: 19px; decorator: image(gear:image/10 scale-none left top); }
.sprite-11 { width: 231px; height: 87px; decorator: image(gear:image/11 scale-none left top); }
.sprite-12 { width: 64px; height: 21px; decorator: image(gear:image/12 scale-none left top); }
.sprite-13 { width: 64px; height: 18px; decorator: image(gear:image/13 scale-none left top); }
.sprite-14 { width: 32px; height: 5px; decorator: image(gear:image/14 scale-none left top); }
.sprite-15 { width: 64px; height: 18px; decorator: image(gear:image/15 scale-none left top); }
.sprite-16 { width: 64px; height: 21px; decorator: image(gear:image/16 scale-none left top); }
.sprite-17 { width: 64px; height: 20px; decorator: image(gear:image/17 scale-none left top); }
.sprite-18 { width: 64px; height: 19px; decorator: image(gear:image/18 scale-none left top); }
.sprite-19 { width: 64px; height: 22px; decorator: image(gear:image/19 scale-none left top); }
.sprite-20 { width: 64px; height: 12px; decorator: image(gear:image/20 scale-none left top); }
.sprite-21 { width: 32px; height: 6px; decorator: image(gear:image/21 scale-none left top); }
.sprite-22 { width: 64px; height: 11px; decorator: image(gear:image/22 scale-none left top); }
.sprite-23 { width: 64px; height: 22px; decorator: image(gear:image/23 scale-none left top); }
.sprite-24 { width: 64px; height: 19px; decorator: image(gear:image/24 scale-none left top); }
.sprite-25 { width: 64px; height: 20px; decorator: image(gear:image/25 scale-none left top); }
.sprite-26 { width: 64px; height: 21px; decorator: image(gear:image/26 scale-none left top); }
.sprite-27 { width: 64px; height: 18px; decorator: image(gear:image/27 scale-none left top); }
.sprite-28 { width: 16px; height: 32px; decorator: image(gear:image/28 scale-none left top); }
.sprite-29 { width: 16px; height: 32px; decorator: image(gear:image/29 scale-none left top); }
.sprite-30 { width: 26px; height: 32px; decorator: image(gear:image/30 scale-none left top); }
.sprite-31 { width: 30px; height: 32px; decorator: image(gear:image/31 scale-none left top); }
.sprite-32 { width: 16px; height: 16px; decorator: image(gear:image/32 scale-none left top); }
.sprite-33 { width: 16px; height: 14px; decorator: image(gear:image/33 scale-none left top); }
.sprite-34 { width: 6px; height: 32px; decorator: image(gear:image/34 scale-none left top); }
.sprite-35 { width: 19px; height: 32px; decorator: image(gear:image/35 scale-none left top); }
