<rml>
<head>
    <title>Quest helper</title>
    <link type="text/rcss" href="main.rcss"/>
</head>
<body data-model="model">
<div id="main" class="window" data-panel="main" data-title="Quest helper" data-if="open">
    <div class="titlebar">{{ title }}</div>
    <div class="body">
        <div class="tabs">
            <button data-for="t : tabs" class="tab" data-attr-id="t.id" data-class-on="t.on">{{ t.name }}</button>
        </div>

        <div data-if="tab == 1">
            <p class="heading">In your backpack</p>
            <p data-if="bag_empty" class="muted pad">no quest items</p>
            <div data-for="b : bag" class="line"><span>{{ b.name }}</span><span class="muted">{{ b.size }}</span></div>
            <p class="heading">{{ near_title }}</p>
            <p data-if="near_empty" class="muted pad">no quest items in sight</p>
            <div class="nlist">
                <div data-for="n : near" class="line"><span class="grow">{{ n.name }}</span><span class="dist">{{ n.dist }}</span><span class="muted pos">{{ n.pos }}</span></div>
            </div>
        </div>

        <div data-if="tab == 2">
            <p data-if="rec_msg != ''" data-class-warn="rec_warn" class="muted wrap">{{ rec_msg }}</p>
            <div data-if="rec_msg != '' &amp;&amp; can_ask"><button class="game-button" id="ask">Refresh</button></div>
            <div data-if="has_state">
                <div class="row space">
                    <span class="muted">{{ rec_head }}</span>
                    <button class="mini" id="refresh">Refresh</button>
                </div>
                <div class="check-row"><span class="text">Show unnamed records</span><input id="unknown" type="checkbox" class="game-check" data-checked="show_unknown"/></div>
                <p data-if="rec_none" class="muted wrap">nothing to show (the server has no quest records of your hero, or they are hidden)</p>
                <div class="rlist">
                    <div data-for="r : records" class="rec">
                        <div data-class-accent="r.known">{{ r.line }}</div>
                        <div data-if="r.area != ''" class="sub muted">{{ r.area }}</div>
                        <div data-if="r.hint != ''" class="sub wrap">{{ r.hint }}</div>
                        <div data-if="r.others != ''" class="sub good">{{ r.others }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div data-if="tab == 3"><p class="wrap">{{ about }}</p></div>

        <p class="warn status" data-if="status != ''">{{ status }}</p>
    </div>
</div>
</body>
</rml>
