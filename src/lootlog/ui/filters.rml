<template name="lootlog-dropdown">
    <head>
        <style>
            .filters button.game-dropdown { margin-right: 4dp; }
            .ddlist { min-width: 170dp; }
        </style>
    </head>
    <body>
        <button class="game-dropdown" data-attr-id="key" data-attr-title="title">
            <span class="padkey a"></span>{{ label }}
        </button>
        <div data-if="dd == key" class="dd-list ddlist" data-nav-scroll>
            <button data-for="o : options" class="mini opt" data-attr-id="o.id" data-class-on="o.on">{{ o.label }}</button>
        </div>
    </body>
</template>
