<rml>
<head>
    <title>Loot log</title>
    <link type="text/rcss" href="log.rcss"/>
    <link type="text/template" href="filters.rml"/>
</head>
<body data-model="model">
<div id="log" class="window" data-panel="log" data-title="Loot log">
    <div data-if="dd != ''" id="ddshade"></div>
    <div class="titlebar">{{ title }}</div>
    <div class="body">
        <div class="row filters">
            <div class="dd ddwrap quality" data-class-open="dd == 'quality'"
                 data-alias-key="filters.quality.key"
                 data-alias-title="filters.quality.title"
                 data-alias-label="filters.quality.label"
                 data-alias-options="filters.quality.options">
                <template src="lootlog-dropdown"></template>
            </div>
            <div class="dd ddwrap category" data-class-open="dd == 'category'"
                 data-alias-key="filters.category.key"
                 data-alias-title="filters.category.title"
                 data-alias-label="filters.category.label"
                 data-alias-options="filters.category.options">
                <template src="lootlog-dropdown"></template>
            </div>
            <div class="dd ddwrap kind" data-class-open="dd == 'kind'"
                 data-alias-key="filters.kind.key"
                 data-alias-title="filters.kind.title"
                 data-alias-label="filters.kind.label"
                 data-alias-options="filters.kind.options">
                <template src="lootlog-dropdown"></template>
            </div>
        </div>
        <div class="row space">
            <span class="label">{{ count }}</span>
            <button class="ibtn" data-event-click="clear" title="Empties the log (also the file)"><span class="padkey a"></span><span class="icon icon-delete"></span>Clear</button>
        </div>
        <div class="rows">
            <div data-for="r : rows" class="entry">
                <span class="when">{{ r.when }}</span>
                <span class="name" data-class-magic="r.q == 'magic'" data-class-rare="r.q == 'rare'" data-class-set="r.q == 'set'" data-class-unique="r.q == 'unique'">{{ r.name }}</span>
                <span class="tail">{{ r.tail }}</span>
            </div>
        </div>
    </div>
</div>
</body>
</rml>
