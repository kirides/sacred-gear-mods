#page { overflow-y: auto; padding: 4dp 6dp; }
.line { display: flex; flex-direction: row; align-items: center; margin: 6dp 0; }
.lab { width: 70dp; }
button.game-button { min-width: 0; padding: 0 38dp 0 37dp; font-size: 16dp; }
.realm-ddlist { min-width: 200dp; }

/* the buttons keep their label and its controller prompt on one line, whatever the row does (flex-shrink wraps and clips them otherwise) */
